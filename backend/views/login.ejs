<!DOCTYPE html>
<html lang="en" data-theme="dark" data-palette="indigo">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Benevolate Integr8 — Enterprise Cloud Access</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/pages/login.css">
  <script src="https://accounts.google.com/gsi/client" onload="initGoogleSSO()" async defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script src="/js/vendor/motion.js"></script>
</head>
<body class="login-body">
  <!-- Topbar: Dynamic Theme & Palette Switcher -->
  <header class="login-topbar">
    <div class="theme-pill-dropdown" id="theme-pill-dropdown">
      <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;color:#94a3b8;">Theme:</span>
      <div class="palette-swatches">
        <button type="button" class="palette-dot palette-dot-indigo active" onclick="setPalette('indigo')" title="Electric Indigo" aria-label="Electric Indigo theme"></button>
        <button type="button" class="palette-dot palette-dot-aurora" onclick="setPalette('aurora')" title="Aurora Cyan" aria-label="Aurora Cyan theme"></button>
        <button type="button" class="palette-dot palette-dot-emerald" onclick="setPalette('emerald')" title="Cyber Emerald" aria-label="Cyber Emerald theme"></button>
        <button type="button" class="palette-dot palette-dot-solar" onclick="setPalette('solar')" title="Solar Forge" aria-label="Solar Forge theme"></button>
        <button type="button" class="palette-dot palette-dot-crimson" onclick="setPalette('crimson')" title="Crimson Stealth" aria-label="Crimson Stealth theme"></button>
      </div>
      <button type="button" class="auto-cycle-toggle active" id="auto-cycle-toggle" onclick="toggleAutoCycle()" title="Toggle Periodic Auto-Cycle">
        <i data-lucide="refresh-cw" style="width:12px;height:12px;"></i>
        <span>Auto</span>
      </button>
    </div>
  </header>

  <!-- Ambient Spotlight & Grid Backdrop -->
  <div class="login-ambient-canvas" aria-hidden="true">
    <div class="ambient-grid"></div>
    <div class="ambient-blob-1"></div>
    <div class="ambient-blob-2"></div>
    <div class="ambient-spotlight" id="ambient-spotlight"></div>
  </div>

  <main class="login-shell">
    <!-- ── LEFT PANE: Abstract Enterprise Value & Resilience Showcase ── -->
    <aside class="showcase-deck" id="showcase-deck" aria-label="Platform Architecture">
      <div class="deck-header">
        <div class="deck-badge">
          <span class="deck-badge-dot"></span>
          <span>Benevolate Integr8 v2.4</span>
        </div>
        <div class="deck-live-metrics">
          <div class="metric-item">
            <i data-lucide="activity" style="width:14px;height:14px;color:#10b981;"></i>
            <span>Fleet Status:</span>
            <span class="metric-value">Operational</span>
          </div>
          <div class="metric-item">
            <i data-lucide="shield" style="width:14px;height:14px;color:var(--login-primary);"></i>
            <span>SOC2 Type II</span>
          </div>
        </div>
      </div>

      <!-- Slides Container -->
      <div class="deck-viewport">
        <!-- Slide 0: Global Cloud Resilience -->
        <article class="deck-slide active" data-slide-index="0" id="slide-0">
          <div class="slide-tag">Global Cloud Infrastructure</div>
          <h2 class="slide-title">Unified Multi-Cloud Delivery with High-Availability SLA</h2>
          <p class="slide-desc">
            Distributed enterprise infrastructure engineered for resilient global operations, automated health monitoring, and sub-second failover redundancy across isolated availability zones.
          </p>

          <div class="deck-visual-card">
            <div class="visual-topbar">
              <div class="visual-title">
                <i data-lucide="globe" style="width:16px;height:16px;color:var(--login-primary);"></i>
                <span>Global Multi-Region Edge Telemetry</span>
              </div>
              <span class="visual-status-pill">99.99% Uptime</span>
            </div>

            <div class="region-grid">
              <div class="region-node">
                <div class="region-name">US-East</div>
                <div class="region-latency">14ms</div>
                <div class="region-status"><span class="status-dot-mini"></span> Healthy</div>
              </div>
              <div class="region-node">
                <div class="region-name">US-West</div>
                <div class="region-latency">18ms</div>
                <div class="region-status"><span class="status-dot-mini"></span> Healthy</div>
              </div>
              <div class="region-node">
                <div class="region-name">EU-Central</div>
                <div class="region-latency">22ms</div>
                <div class="region-status"><span class="status-dot-mini"></span> Healthy</div>
              </div>
            </div>
          </div>
        </article>

        <!-- Slide 1: Zero-Trust Security & Identity -->
        <article class="deck-slide" data-slide-index="1" id="slide-1">
          <div class="slide-tag">Zero-Trust Access Governance</div>
          <h2 class="slide-title">Hardware-Backed Security & Cryptographic Identity</h2>
          <p class="slide-desc">
            Continuous token validation, ephemeral session credentials, and encrypted key management designed to protect organizational workspaces without friction.
          </p>

          <div class="deck-visual-card">
            <div class="visual-topbar">
              <div class="visual-title">
                <i data-lucide="shield-check" style="width:16px;height:16px;color:var(--login-primary);"></i>
                <span>Zero-Trust Verification Pipeline</span>
              </div>
              <span class="visual-status-pill">KMS Encrypted</span>
            </div>

            <div class="security-metrics-list">
              <div class="sec-metric-row">
                <div class="sec-metric-left">
                  <i data-lucide="key" style="width:15px;height:15px;color:#f59e0b;"></i>
                  <span>Cryptographic Session Tokens</span>
                </div>
                <span class="sec-metric-val">Ephemeral TTL</span>
              </div>
              <div class="sec-metric-row">
                <div class="sec-metric-left">
                  <i data-lucide="lock" style="width:15px;height:15px;color:var(--login-primary);"></i>
                  <span>Envelope Encryption</span>
                </div>
                <span class="sec-metric-val">AES-256 GCM</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Slide 2: Immutable Governance & Compliance -->
        <article class="deck-slide" data-slide-index="2" id="slide-2">
          <div class="slide-tag">Enterprise Compliance</div>
          <h2 class="slide-title">Continuous Observability & Tamper-Proof Audit Streams</h2>
          <p class="slide-desc">
            Centralized telemetry, automated policy enforcement, and immutable audit logs tailored for high-velocity teams operating in regulated environments.
          </p>

          <div class="deck-visual-card">
            <div class="visual-topbar">
              <div class="visual-title">
                <i data-lucide="file-check" style="width:16px;height:16px;color:var(--login-primary);"></i>
                <span>Automated Compliance Ledger</span>
              </div>
              <span class="visual-status-pill">Certified SOC2</span>
            </div>

            <div class="security-metrics-list">
              <div class="sec-metric-row">
                <div class="sec-metric-left">
                  <i data-lucide="check-circle-2" style="width:15px;height:15px;color:#10b981;"></i>
                  <span>Role-Based Access Control</span>
                </div>
                <span class="sec-metric-val">Enforced</span>
              </div>
              <div class="sec-metric-row">
                <div class="sec-metric-left">
                  <i data-lucide="clock" style="width:15px;height:15px;color:#06b6d4;"></i>
                  <span>Immutable Audit Retention</span>
                </div>
                <span class="sec-metric-val">Real-Time Sync</span>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- Deck Tab Controls & Auto-advancing Timeline -->
      <nav class="deck-controls" aria-label="Deck Slides">
        <button type="button" class="deck-tab-btn active" data-target-slide="0" onclick="switchDeckSlide(0)">
          <div class="deck-tab-progress"><div class="deck-tab-fill" id="tab-fill-0"></div></div>
          <span class="deck-tab-title">Resilience</span>
        </button>
        <button type="button" class="deck-tab-btn" data-target-slide="1" onclick="switchDeckSlide(1)">
          <div class="deck-tab-progress"><div class="deck-tab-fill" id="tab-fill-1"></div></div>
          <span class="deck-tab-title">Zero-Trust</span>
        </button>
        <button type="button" class="deck-tab-btn" data-target-slide="2" onclick="switchDeckSlide(2)">
          <div class="deck-tab-progress"><div class="deck-tab-fill" id="tab-fill-2"></div></div>
          <span class="deck-tab-title">Governance</span>
        </button>
      </nav>
    </aside>

    <!-- ── RIGHT PANE: Radiant Glassmorphism Auth Portal ── -->
    <section class="auth-portal-card" id="auth-portal-card">
      <div class="radiant-border-beam" aria-hidden="true"></div>

      <!-- Loading Overlay -->
      <div id="auth-loading-overlay" aria-live="assertive">
        <div class="dual-ring-spinner">
          <div class="spinner-outer"></div>
          <img src="/favicon.png" class="spinner-inner-img" alt="Benevolate Integr8">
        </div>
        <div id="auth-loading-text">Authenticating SSO Workspace...</div>
      </div>

      <!-- STAGE: Login Form Section -->
      <div id="login-form-section">
        <div class="auth-brand-block">
          <div class="brand-icon-wrapper">
            <div class="brand-icon-halo"></div>
            <img src="/favicon.png" class="brand-logo-img" alt="Benevolate Integr8 Logo">
          </div>
          <h1 class="brand-title">Benevolate Integr8</h1>
          <p class="brand-subtitle">Sign in to access your organization workspace</p>
        </div>

        <!-- Google Workspace SSO Container (with Instant Native Fallback) -->
        <div class="sso-section">
          <div id="g_id_signin_btn">
            <button type="button" id="google-sso-fallback-btn" class="google-sso-btn" onclick="triggerGoogleSSO()">
              <svg width="18" height="18" viewBox="0 0 18 18">
                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.347 2.825.957 4.039l3.007-2.332z"/>
                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
              </svg>
              <span>Continue with Google Workspace</span>
            </button>
          </div>
        </div>

        <div class="auth-divider">
          <div class="auth-divider-line"></div>
          <span>or sign in with credentials</span>
          <div class="auth-divider-line"></div>
        </div>

        <!-- Credentials Form -->
        <form id="login-form" onsubmit="handleLoginSubmit(event)" novalidate>
          <div class="form-group">
            <div class="form-label-row">
              <label for="login-username" class="form-label">Username</label>
            </div>
            <div class="input-container">
              <input 
                type="text" 
                id="login-username" 
                name="username"
                class="input-field" 
                placeholder="Enter username..." 
                autocomplete="username" 
                required
                autofocus>
              <i data-lucide="user" class="input-icon-left"></i>
            </div>
          </div>

          <div class="form-group">
            <div class="form-label-row">
              <label for="login-password" class="form-label">Password</label>
            </div>
            <div class="input-container">
              <input 
                type="password" 
                id="login-password" 
                name="password"
                class="input-field" 
                placeholder="Enter password..." 
                autocomplete="current-password" 
                required>
              <i data-lucide="lock" class="input-icon-left"></i>
              <button 
                type="button" 
                id="toggle-pwd-btn" 
                class="input-btn-right" 
                onclick="togglePasswordVisibility()" 
                title="Toggle password visibility" 
                aria-label="Toggle password visibility">
                <i data-lucide="eye" id="toggle-pwd-icon" style="width:16px;height:16px;"></i>
              </button>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="login-error" class="auth-error-alert" role="alert" aria-live="polite"></div>

          <button type="submit" id="login-submit-btn" class="auth-primary-btn">
            <span>Sign In</span>
            <i data-lucide="arrow-right" style="width:16px;height:16px;"></i>
          </button>
        </form>
      </div>

      <!-- STAGE: Two-Factor Authentication Challenge -->
      <div id="twofa-section">
        <div class="twofa-header">
          <div class="twofa-badge-icon">
            <i data-lucide="shield-check" style="width:30px;height:30px;"></i>
          </div>
          <h2 class="twofa-title">Two-Factor Verification</h2>
          <p class="twofa-subtitle">
            Enter the 6-digit security code generated by your Authenticator app.
          </p>
        </div>

        <form id="twofa-form" onsubmit="handle2FASubmit(event)" novalidate>
          <div class="totp-input-wrapper">
            <input 
              type="text" 
              id="totp-code" 
              name="totp"
              class="totp-code-field" 
              maxlength="6" 
              placeholder="000 000" 
              inputmode="numeric" 
              autocomplete="one-time-code"
              oninput="this.value=this.value.replace(/[^0-9]/g,'')">
          </div>

          <div id="twofa-error" class="auth-error-alert" role="alert" aria-live="polite"></div>

          <button type="submit" id="twofa-submit-btn" class="auth-primary-btn" disabled>
            <span>Verify Security Code</span>
            <i data-lucide="check" style="width:16px;height:16px;"></i>
          </button>

          <div style="text-align:center;">
            <button type="button" class="auth-back-link" onclick="handleAuthBack()">
              <i data-lucide="arrow-left" style="width:14px;height:14px;"></i>
              <span>Back to Credentials</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Footer Notes -->
      <footer class="auth-footer">
        <div>Enterprise Cloud Orchestration Platform</div>
        <div class="auth-footer-links">
          <span class="auth-footer-link">AWS Verified</span>
          <span>&middot;</span>
          <span class="auth-footer-link">KMS Encrypted</span>
          <span>&middot;</span>
          <span class="auth-footer-link">&copy; 2026 Benevolate</span>
        </div>
      </footer>
    </section>
  </main>

  <script src="/js/api.js"></script>
  <script src="/js/auth.js"></script>
  <script>
    var pending2FA = null;
    var GOOGLE_CLIENT_ID = '1018746602979-blog5afpgc9iv4ke0gllpam30v5fs8b7.apps.googleusercontent.com';
    var activeSlideIndex = 0;
    var slideDuration = 6000;
    var slideStartTime = Date.now();
    var animFrameId = null;

    // ── Palette Themes Engine ──
    var PALETTES = ['indigo', 'aurora', 'emerald', 'solar', 'crimson'];
    var currentPaletteIndex = 0;
    var autoCycleInterval = null;
    var isAutoCycleActive = true;

    function setPalette(name, userInitiated) {
      if (!PALETTES.includes(name)) name = 'indigo';
      document.documentElement.setAttribute('data-palette', name);
      localStorage.setItem('benevolate-color-palette', name);
      currentPaletteIndex = PALETTES.indexOf(name);

      document.querySelectorAll('.palette-dot').forEach(function(dot) {
        dot.classList.toggle('active', dot.classList.contains('palette-dot-' + name));
      });

      if (userInitiated) {
        // Pause auto-cycle briefly if user clicks manually
        stopAutoCycleTimer();
        setTimeout(function() {
          if (isAutoCycleActive) startAutoCycleTimer();
        }, 12000);
      }
    }

    function cycleNextPalette() {
      var next = (currentPaletteIndex + 1) % PALETTES.length;
      setPalette(PALETTES[next], false);
    }

    function startAutoCycleTimer() {
      stopAutoCycleTimer();
      // Smoothly rotate theme every 30 seconds
      autoCycleInterval = setInterval(cycleNextPalette, 30000);
    }

    function stopAutoCycleTimer() {
      if (autoCycleInterval) {
        clearInterval(autoCycleInterval);
        autoCycleInterval = null;
      }
    }

    function toggleAutoCycle() {
      isAutoCycleActive = !isAutoCycleActive;
      var toggleBtn = document.getElementById('auto-cycle-toggle');
      if (toggleBtn) toggleBtn.classList.toggle('active', isAutoCycleActive);

      if (isAutoCycleActive) {
        startAutoCycleTimer();
        cycleNextPalette();
      } else {
        stopAutoCycleTimer();
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Restore saved palette or initialize default
      var saved = localStorage.getItem('benevolate-color-palette');
      if (saved && PALETTES.includes(saved)) {
        setPalette(saved, false);
      } else {
        setPalette('indigo', false);
      }
      if (isAutoCycleActive) startAutoCycleTimer();

      // Initialize Lucide vector icons
      if (window.lucide) {
        lucide.createIcons();
      }

      // Initialize Google SSO immediately and poll if async
      initGoogleSSO();

      // Launch Deck Gallery auto-advancing choreography
      startDeckGallery();

      // Setup Mouse Spotlight Effect
      setupSpotlightTracking();

      // Setup 2FA Code Input Listener
      var totpInput = document.getElementById('totp-code');
      if (totpInput) {
        totpInput.addEventListener('input', function() {
          var btn = document.getElementById('twofa-submit-btn');
          if (this.value.length === 6) {
            btn.disabled = false;
            if (window.Motion) {
              Motion.animate(btn, { scale: [0.97, 1] }, { duration: 0.2, type: 'spring' });
            }
          } else {
            btn.disabled = true;
          }
        });
      }

      // Entrance motion
      if (window.Motion) {
        Motion.animate('.auth-portal-card', { opacity: [0, 1], y: [16, 0] }, { duration: 0.45, ease: 'easeOut' });
        Motion.animate('.showcase-deck', { opacity: [0, 1], x: [-16, 0] }, { duration: 0.5, ease: 'easeOut' });
      }
    });

    // ── Spotlight Tracking Choreography ──
    function setupSpotlightTracking() {
      var spotlight = document.getElementById('ambient-spotlight');
      var card = document.getElementById('auth-portal-card');

      window.addEventListener('mousemove', function(e) {
        if (spotlight) {
          spotlight.style.opacity = '1';
          spotlight.style.left = e.clientX + 'px';
          spotlight.style.top = e.clientY + 'px';
        }

        if (card) {
          var rect = card.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', x + 'px');
          card.style.setProperty('--mouse-y', y + 'px');
        }
      });
    }

    // ── Deck Gallery Slide Switching & Spring Motion ──
    function switchDeckSlide(index) {
      if (index === activeSlideIndex) return;

      var slides = document.querySelectorAll('.deck-slide');
      var tabBtns = document.querySelectorAll('.deck-tab-btn');
      
      slides.forEach(function(s, idx) {
        if (idx === index) {
          s.classList.add('active');
          if (window.Motion) {
            Motion.animate(s, { opacity: [0, 1], y: [10, 0] }, { duration: 0.35, ease: 'easeOut' });
          }
        } else {
          s.classList.remove('active');
        }
      });

      tabBtns.forEach(function(btn, idx) {
        btn.classList.toggle('active', idx === index);
      });

      for (var i = 0; i < 3; i++) {
        var fill = document.getElementById('tab-fill-' + i);
        if (fill) {
          fill.style.width = i < index ? '100%' : '0%';
        }
      }

      activeSlideIndex = index;
      slideStartTime = Date.now();
    }

    function startDeckGallery() {
      slideStartTime = Date.now();

      function updateProgress() {
        var elapsed = Date.now() - slideStartTime;
        var progress = Math.min((elapsed / slideDuration) * 100, 100);

        var fill = document.getElementById('tab-fill-' + activeSlideIndex);
        if (fill) {
          fill.style.width = progress + '%';
        }

        if (elapsed >= slideDuration) {
          var nextIndex = (activeSlideIndex + 1) % 3;
          switchDeckSlide(nextIndex);
        }

        animFrameId = requestAnimationFrame(updateProgress);
      }

      animFrameId = requestAnimationFrame(updateProgress);
    }

    // ── Form Visibility & 2FA State Transitions ──
    function togglePasswordVisibility() {
      var pwdInput = document.getElementById('login-password');
      var icon = document.getElementById('toggle-pwd-icon');
      if (!pwdInput) return;

      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        if (icon) icon.setAttribute('data-lucide', 'eye-off');
      } else {
        pwdInput.type = 'password';
        if (icon) icon.setAttribute('data-lucide', 'eye');
      }
      if (window.lucide) lucide.createIcons();
    }

    function handleAuthBack() {
      pending2FA = null;
      var totp = document.getElementById('totp-code');
      if (totp) totp.value = '';
      
      var err = document.getElementById('twofa-error');
      if (err) err.style.display = 'none';

      var twofaSection = document.getElementById('twofa-section');
      var loginSection = document.getElementById('login-form-section');

      if (window.Motion) {
        Motion.animate(twofaSection, { opacity: [1, 0], x: [0, 20] }, { duration: 0.25 }).finished.then(function() {
          twofaSection.style.display = 'none';
          loginSection.style.display = 'block';
          Motion.animate(loginSection, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.3, type: 'spring' });
          initGoogleSSO();
        });
      } else {
        twofaSection.style.display = 'none';
        loginSection.style.display = 'block';
        initGoogleSSO();
      }
    }

    function showError(elId, msg) {
      var el = document.getElementById(elId);
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';

      if (window.Motion) {
        Motion.animate(el, { x: [-8, 8, -4, 4, 0] }, { duration: 0.35 });
      }
    }

    // ── Authentication Submission Handlers ──
    async function handleLoginSubmit(e) {
      e.preventDefault();
      var username = document.getElementById('login-username').value.trim();
      var password = document.getElementById('login-password').value;
      if (!username || !password) {
        return showError('login-error', 'Please provide both username and password');
      }

      var btn = document.getElementById('login-submit-btn');
      var originalBtnContent = btn.innerHTML;
      btn.innerHTML = '<span class="animate-spin" style="display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;"></span><span>Signing In...</span>';
      btn.disabled = true;
      document.getElementById('login-error').style.display = 'none';

      try {
        var res = await auth.login(username, password);
        if (res.ok) {
          if (res.require2FA) {
            pending2FA = { tempToken: res.tempToken, username: res.username };
            var loginSection = document.getElementById('login-form-section');
            var twofaSection = document.getElementById('twofa-section');

            if (window.Motion) {
              Motion.animate(loginSection, { opacity: [1, 0], x: [0, -20] }, { duration: 0.25 }).finished.then(function() {
                loginSection.style.display = 'none';
                twofaSection.style.display = 'block';
                Motion.animate(twofaSection, { opacity: [0, 1], x: [20, 0] }, { duration: 0.3, type: 'spring' });
                if (window.lucide) lucide.createIcons();
                document.getElementById('totp-code').focus();
              });
            } else {
              loginSection.style.display = 'none';
              twofaSection.style.display = 'block';
              if (window.lucide) lucide.createIcons();
              document.getElementById('totp-code').focus();
            }
          } else {
            window.location.href = res.isProfileCompleted === false ? '/settings' : '/';
          }
        } else {
          showError('login-error', res.error || 'Authentication credentials rejected');
        }
      } catch (err) {
        showError('login-error', 'Connection error occurred during sign-in');
      } finally {
        btn.innerHTML = originalBtnContent;
        btn.disabled = false;
        if (window.lucide) lucide.createIcons();
      }
    }

    async function handle2FASubmit(e) {
      e.preventDefault();
      var code = document.getElementById('totp-code').value.trim();
      if (!code || code.length !== 6) {
        return showError('twofa-error', 'Enter a valid 6-digit verification code');
      }

      var btn = document.getElementById('twofa-submit-btn');
      var originalBtnContent = btn.innerHTML;
      btn.innerHTML = '<span class="animate-spin" style="display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;"></span><span>Verifying...</span>';
      btn.disabled = true;
      document.getElementById('twofa-error').style.display = 'none';

      try {
        var res = await auth.verify2FA(pending2FA.tempToken, code);
        if (res.ok) {
          window.location.href = res.isProfileCompleted === false ? '/settings' : '/';
        } else {
          showError('twofa-error', res.error || 'Verification code invalid or expired');
        }
      } catch (err) {
        showError('twofa-error', 'Network error during code verification');
      } finally {
        btn.innerHTML = originalBtnContent;
        btn.disabled = false;
        if (window.lucide) lucide.createIcons();
      }
    }

    // ── Google Workspace SSO Robust Handling & Retry Loop ──
    var _gsoAttempts = 0;
    function triggerGoogleSSO() {
      if (window.google && window.google.accounts && window.google.accounts.id) {
        window.google.accounts.id.prompt();
      } else {
        initGoogleSSO();
      }
    }

    function initGoogleSSO() {
      if (!window.google || !window.google.accounts || !window.google.accounts.id) {
        _gsoAttempts++;
        if (_gsoAttempts < 35) {
          setTimeout(initGoogleSSO, 120);
        }
        return;
      }
      try {
        window.google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: async function(response) {
            if (response && response.credential) {
              var overlay = document.getElementById('auth-loading-overlay');
              if (overlay) overlay.style.display = 'flex';
              try {
                var res = await auth.loginWithGoogle(response.credential);
                if (res.ok) {
                  if (res.require2FA) {
                    if (overlay) overlay.style.display = 'none';
                    pending2FA = { tempToken: res.tempToken, username: res.username };
                    var loginSection = document.getElementById('login-form-section');
                    var twofaSection = document.getElementById('twofa-section');
                    loginSection.style.display = 'none';
                    twofaSection.style.display = 'block';
                    if (window.lucide) lucide.createIcons();
                    document.getElementById('totp-code').focus();
                  } else {
                    var txt = document.getElementById('auth-loading-text');
                    if (txt) txt.textContent = 'Workspace Verified. Redirecting...';
                    window.location.href = res.isProfileCompleted === false ? '/settings' : '/';
                  }
                } else {
                  if (overlay) overlay.style.display = 'none';
                  showError('login-error', res.error || 'Google Workspace sign-in failed');
                }
              } catch (err) {
                if (overlay) overlay.style.display = 'none';
                showError('login-error', 'SSO network error occurred');
              }
            }
          }
        });
        
        var btnContainer = document.getElementById('g_id_signin_btn');
        if (btnContainer) {
          var card = document.getElementById('auth-portal-card');
          var targetWidth = card ? Math.min(card.clientWidth - 72, 380) : 380;
          btnContainer.innerHTML = '';
          window.google.accounts.id.renderButton(btnContainer, {
            type: 'standard',
            shape: 'pill',
            theme: 'filled_black',
            text: 'continue_with',
            size: 'large',
            logo_alignment: 'left',
            width: targetWidth
          });
        }
      } catch(err) {
        console.error('Google SSO init failed:', err);
      }
    }
  </script>
</body>
</html>
