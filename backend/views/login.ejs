  <script src="/js/api.js"></script>
  <script src="/js/auth.js"></script>
  <script>
    var pending2FA = null;
    var GOOGLE_CLIENT_ID = '1018746602979-blog5afpgc9iv4ke0gllpam30v5fs8b7.apps.googleusercontent.com';

    // ── 4 CURATED THEME PALETTES ──
    var PALETTES = [
      { id: 'sandstone', name: 'Sandstone' },
      { id: 'indigo',    name: 'Electric Indigo' },
      { id: 'emerald',   name: 'Cyber Emerald' },
      { id: 'aurora',    name: 'Midnight Aurora' }
    ];

    function get30MinuteThemeIndex() {
      var current30MinBlock = Math.floor(Date.now() / (30 * 60 * 1000));
      return current30MinBlock % PALETTES.length;
    }

    function applyAutoTheme() {
      var manualOverride = localStorage.getItem('benevolate-manual-palette');
      var palette = manualOverride ? PALETTES.find(function(p) { return p.id === manualOverride; }) : null;
      if (!palette) {
        var idx = get30MinuteThemeIndex();
        palette = PALETTES[idx];
      }
      setPalette(palette.id, false);
    }

    function setPalette(id, isManual) {
      var palette = PALETTES.find(function(p) { return p.id === id; }) || PALETTES[0];
      document.documentElement.setAttribute('data-palette', palette.id);

      if (isManual) {
        localStorage.setItem('benevolate-manual-palette', palette.id);
      }
    }

    // ── SLOW WATER DROPLET SPREAD OVER DRESS (CAPILLARY ABSORPTION) ──
    function triggerDropletBleed(event) {
      var btn = document.getElementById('theme-toggle-btn');
      var rect = btn.getBoundingClientRect();
      var originX = rect.left + rect.width / 2;
      var originY = rect.top + rect.height / 2;

      // Select next palette
      var currentId = document.documentElement.getAttribute('data-palette') || 'sandstone';
      var currentIndex = PALETTES.findIndex(function(p) { return p.id === currentId; });
      var nextIndex = (currentIndex + 1) % PALETTES.length;
      var nextPalette = PALETTES[nextIndex];

      // Spawn droplet capillary absorption layers
      var canvasContainer = document.getElementById('fabric-droplet-canvas');
      if (canvasContainer) {
        // 1. Soft bleeding diffusion layer
        var bleed = document.createElement('div');
        bleed.className = 'fabric-droplet-bleed';
        bleed.style.left = originX + 'px';
        bleed.style.top = originY + 'px';
        canvasContainer.appendChild(bleed);

        // 2. Capillary absorption boundary ring
        var ring = document.createElement('div');
        ring.className = 'fabric-droplet-ring';
        ring.style.left = originX + 'px';
        ring.style.top = originY + 'px';
        canvasContainer.appendChild(ring);

        setTimeout(function() {
          if (bleed && bleed.parentNode) bleed.parentNode.removeChild(bleed);
          if (ring && ring.parentNode) ring.parentNode.removeChild(ring);
        }, 1600);
      }

      // Gemini starburst rotation & droplet bounce
      if (window.Motion) {
        Motion.animate('.gemini-star-svg', { rotate: [0, 90, 180] }, { duration: 0.8, ease: 'easeOut' });
        Motion.animate(btn, { scale: [1, 0.88, 1.14, 1] }, { duration: 0.55, ease: 'easeOut' });
      }

      // Smoothly apply new palette so it absorbs under the capillary spread
      setTimeout(function() {
        setPalette(nextPalette.id, true);
      }, 150);
    }

    // ── 3D PERSPECTIVE DECK GALLERY INTERACTIONS ──
    function handleDeckPerspective(e) {
      var container = document.getElementById('deck-gallery');
      if (!container) return;
      var rect = container.getBoundingClientRect();
      var x = e.clientX - rect.left - rect.width / 2;
      var y = e.clientY - rect.top - rect.height / 2;

      var rotY = (x / (rect.width / 2)) * 8;
      var rotX = -(y / (rect.height / 2)) * 6;

      var centerCard = document.getElementById('deck-card-2');
      if (centerCard) {
        centerCard.style.transform = 'translateY(-8px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) scale(1.04)';
      }
    }

    function resetDeckPerspective() {
      var centerCard = document.getElementById('deck-card-2');
      if (centerCard) {
        centerCard.style.transform = 'translateX(0) rotate(0deg) scale(1)';
      }
    }

    var currentActiveDeck = 2;
    function focusDeckCard(cardNum) {
      currentActiveDeck = cardNum;
      var c1 = document.getElementById('deck-card-1');
      var c2 = document.getElementById('deck-card-2');
      var c3 = document.getElementById('deck-card-3');
      var p1 = document.getElementById('pill-1');
      var p2 = document.getElementById('pill-2');
      var p3 = document.getElementById('pill-3');

      [c1, c2, c3].forEach(function(el) {
        el.className = 'deck-card';
      });
      [p1, p2, p3].forEach(function(el) {
        el.classList.remove('active');
      });

      if (cardNum === 1) {
        c1.className = 'deck-card deck-card-center';
        c2.className = 'deck-card deck-card-right';
        c3.className = 'deck-card deck-card-left';
        p1.classList.add('active');
      } else if (cardNum === 2) {
        c1.className = 'deck-card deck-card-left';
        c2.className = 'deck-card deck-card-center';
        c3.className = 'deck-card deck-card-right';
        p2.classList.add('active');
      } else {
        c1.className = 'deck-card deck-card-right';
        c2.className = 'deck-card deck-card-left';
        c3.className = 'deck-card deck-card-center';
        p3.classList.add('active');
      }
    }

    // ── STAGE 1 -> STAGE 2 SPRING MOTION MORPHING ──
    function showAuthStage() {
      var splash = document.getElementById('splash-stage');
      var authStage = document.getElementById('auth-stage');
      var card = document.getElementById('auth-panel-card');

      if (window.Motion) {
        Motion.animate(splash, { opacity: [1, 0], scale: [1, 0.95] }, { duration: 0.35 }).finished.then(function() {
          splash.style.display = 'none';
          authStage.style.display = 'flex';
          authStage.setAttribute('aria-hidden', 'false');
          Motion.animate(card, { opacity: [0, 1], y: [30, 0], scale: [0.96, 1] }, { duration: 0.45, type: 'spring', stiffness: 300, damping: 25 });
          initGoogleSSO();
          document.getElementById('login-username').focus();
        });
      } else {
        splash.style.display = 'none';
        authStage.style.display = 'flex';
        authStage.setAttribute('aria-hidden', 'false');
        initGoogleSSO();
        document.getElementById('login-username').focus();
      }
    }

    function handleAuthBack() {
      if (pending2FA) {
        pending2FA = null;
        var totp = document.getElementById('totp-code');
        if (totp) totp.value = '';
        var err = document.getElementById('twofa-error');
        if (err) err.style.display = 'none';

        var twofaSection = document.getElementById('twofa-section');
        var loginSection = document.getElementById('login-form-section');
        if (twofaSection) twofaSection.style.display = 'none';
        if (loginSection) loginSection.style.display = 'block';
      } else {
        var splash = document.getElementById('splash-stage');
        var authStage = document.getElementById('auth-stage');
        var card = document.getElementById('auth-panel-card');

        if (window.Motion) {
          Motion.animate(card, { opacity: [1, 0], y: [0, 24], scale: [1, 0.96] }, { duration: 0.25 }).finished.then(function() {
            authStage.style.display = 'none';
            authStage.setAttribute('aria-hidden', 'true');
            splash.style.display = 'flex';
            Motion.animate(splash, { opacity: [0, 1], scale: [0.95, 1] }, { duration: 0.35 });
          });
        } else {
          authStage.style.display = 'none';
          authStage.setAttribute('aria-hidden', 'true');
          splash.style.display = 'flex';
        }
      }
    }

    // ── LIVING GENERATIVE CANVAS PARTICLES & LIGHT BEAMS ──
    function initAmbientCanvas() {
      var canvas = document.getElementById('ambient-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var width, height;
      var particles = [];

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      for (var i = 0; i < 28; i++) {
        particles.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          radius: Math.random() * 2 + 0.8,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.35,
          alpha: Math.random() * 0.5 + 0.15
        });
      }

      function draw() {
        ctx.clearRect(0, 0, width, height);

        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, ' + p.alpha + ')';
          ctx.fill();

          // Connecting light strands
          for (var j = i + 1; j < particles.length; j++) {
            var p2 = particles[j];
            var dist = Math.hypot(p.x - p2.x, p.y - p2.y);
            if (dist < 130) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.strokeStyle = 'rgba(255, 255, 255, ' + (0.05 * (1 - dist / 130)) + ')';
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(draw);
      }
      draw();
    }

    // ── FORM & AUTH PROTOCOLS ──
    document.addEventListener('DOMContentLoaded', function() {
      applyAutoTheme();
      initAmbientCanvas();

      if (window.lucide) {
        lucide.createIcons();
      }

      initGoogleSSO();

      var totpInput = document.getElementById('totp-code');
      if (totpInput) {
        totpInput.addEventListener('input', function() {
          var btn = document.getElementById('twofa-submit-btn');
          if (this.value.length === 6) {
            btn.disabled = false;
            if (window.Motion) {
              Motion.animate(btn, { scale: [0.97, 1] }, { duration: 0.2, type: 'spring' });
            }
          } else {
            btn.disabled = true;
          }
        });
      }

      if (window.Motion) {
        Motion.animate('.landing-hero-shell', { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, ease: 'easeOut' });
      }
    });

    function togglePasswordVisibility() {
      var pwdInput = document.getElementById('login-password');
      var icon = document.getElementById('toggle-pwd-icon');
      if (!pwdInput) return;

      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        if (icon) icon.setAttribute('data-lucide', 'eye-off');
      } else {
        pwdInput.type = 'password';
        if (icon) icon.setAttribute('data-lucide', 'eye');
      }
      if (window.lucide) lucide.createIcons();
    }

    function showLoading(msg) {
      var overlay = document.getElementById('auth-loading-overlay');
      var txt = document.getElementById('auth-loading-text');
      if (overlay) overlay.style.display = 'flex';
      if (txt) txt.textContent = msg || 'Authenticating...';
    }

    function hideLoading() {
      var overlay = document.getElementById('auth-loading-overlay');
      if (overlay) overlay.style.display = 'none';
    }

    function showError(msg) {
      var banner = document.getElementById('login-error-banner');
      var text = document.getElementById('login-error-msg');
      if (banner && text) {
        text.textContent = msg || 'Authentication failed. Please verify credentials.';
        banner.style.display = 'block';
        if (window.Motion) {
          Motion.animate(banner, { scale: [0.98, 1], opacity: [0, 1] }, { duration: 0.2 });
        }
      }
    }

    function hideError() {
      var banner = document.getElementById('login-error-banner');
      if (banner) banner.style.display = 'none';
    }

    // Google SSO
    var googleInitAttempts = 0;
    function initGoogleSSO() {
      if (typeof google === 'undefined' || !google.accounts || !google.accounts.id) {
        if (googleInitAttempts < 35) {
          googleInitAttempts++;
          setTimeout(initGoogleSSO, 120);
        }
        return;
      }

      try {
        google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: handleGoogleCredentialResponse,
          auto_select: false,
          cancel_on_tap_outside: true
        });

        var btnContainer = document.getElementById('g_id_signin_btn');
        if (btnContainer) {
          google.accounts.id.renderButton(btnContainer, {
            theme: 'filled_black',
            size: 'large',
            width: '360',
            text: 'continue_with',
            shape: 'pill',
            logo_alignment: 'left'
          });
        }
      } catch (err) {
        console.warn('Google SSO init exception:', err);
      }
    }

    function handleGoogleCustomClick() {
      if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
        google.accounts.id.prompt();
      } else {
        showError('Google Workspace SSO is still initializing. Please use credentials or retry in a moment.');
      }
    }

    async function handleGoogleCredentialResponse(response) {
      if (!response || !response.credential) return;
      showLoading('Authenticating with Google Workspace...');
      hideError();

      try {
        var res = await fetch('/api/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential: response.credential })
        });
        var data = await res.json();
        if (res.ok && data.token) {
          if (window.AuthService && AuthService.setSession) {
            AuthService.setSession(data.token, data.user);
          } else {
            localStorage.setItem('auth_token', data.token);
            if (data.user) localStorage.setItem('auth_user', JSON.stringify(data.user));
          }
          window.location.href = data.redirect || '/dashboard';
        } else {
          hideLoading();
          showError(data.error || 'Google authentication rejected.');
        }
      } catch (err) {
        hideLoading();
        showError('Network error connecting to authentication provider.');
      }
    }

    // Credentials Submit
    async function handleCredentialsSubmit(event) {
      event.preventDefault();
      var username = document.getElementById('login-username').value.trim();
      var password = document.getElementById('login-password').value;

      if (!username || !password) {
        showError('Username and password are required.');
        return;
      }

      showLoading('Verifying credentials...');
      hideError();

      try {
        var res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username, password: password })
        });
        var data = await res.json();

        if (res.ok) {
          if (data.requires2FA) {
            hideLoading();
            pending2FA = { tempToken: data.tempToken, userId: data.userId };
            var loginSection = document.getElementById('login-form-section');
            var twofaSection = document.getElementById('twofa-section');
            loginSection.style.display = 'none';
            twofaSection.style.display = 'block';
            var totpField = document.getElementById('totp-code');
            if (totpField) totpField.focus();
            return;
          }

          if (data.token) {
            if (window.AuthService && AuthService.setSession) {
              AuthService.setSession(data.token, data.user);
            } else {
              localStorage.setItem('auth_token', data.token);
              if (data.user) localStorage.setItem('auth_user', JSON.stringify(data.user));
            }
            window.location.href = data.redirect || '/dashboard';
          }
        } else {
          hideLoading();
          showError(data.error || 'Invalid username or password.');
        }
      } catch (err) {
        hideLoading();
        showError('Connection error. Please try again.');
      }
    }

    // 2FA Submit
    async function handle2FASubmit(event) {
      event.preventDefault();
      var code = document.getElementById('totp-code').value.trim();
      var errEl = document.getElementById('twofa-error');
      var errMsg = document.getElementById('twofa-error-msg');

      if (!code || code.length !== 6) {
        if (errEl && errMsg) {
          errMsg.textContent = 'Please enter a complete 6-digit code.';
          errEl.style.display = 'block';
        }
        return;
      }

      showLoading('Validating security code...');
      if (errEl) errEl.style.display = 'none';

      try {
        var res = await fetch('/api/auth/2fa/verify-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code: code,
            tempToken: pending2FA ? pending2FA.tempToken : null,
            userId: pending2FA ? pending2FA.userId : null
          })
        });
        var data = await res.json();

        if (res.ok && data.token) {
          if (window.AuthService && AuthService.setSession) {
            AuthService.setSession(data.token, data.user);
          } else {
            localStorage.setItem('auth_token', data.token);
            if (data.user) localStorage.setItem('auth_user', JSON.stringify(data.user));
          }
          window.location.href = data.redirect || '/dashboard';
        } else {
          hideLoading();
          if (errEl && errMsg) {
            errMsg.textContent = data.error || 'Invalid verification code. Please try again.';
            errEl.style.display = 'block';
          }
        }
      } catch (err) {
        hideLoading();
        if (errEl && errMsg) {
          errMsg.textContent = 'Network error verifying security code.';
          errEl.style.display = 'block';
        }
      }
    }
  </script>
</body>
</html>
