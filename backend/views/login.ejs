<!DOCTYPE html>
<html lang="en" data-theme="dark" data-palette="indigo">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Benevolate Integr8 — Ship faster. Stay in control.</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/pages/login.css">
  <script src="https://accounts.google.com/gsi/client" onload="initGoogleSSO()" async defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script src="/js/vendor/motion.js"></script>
</head>
<body class="login-body">
  <!-- Topbar: 30-Minute Dynamic Theme Indicator & Manual Switcher -->
  <header class="login-topbar">
    <button type="button" class="theme-sync-badge" id="theme-sync-btn" onclick="cycleNextPalette()" title="Click to cycle theme palette (Auto-rotates every 30 mins)">
      <span class="theme-indicator-dot" id="theme-indicator-dot"></span>
      <span id="theme-name-label">Theme: Electric Indigo</span>
      <i data-lucide="sparkles" style="width:12px;height:12px;color:#94a3b8;"></i>
    </button>
  </header>

  <!-- Ambient Backdrop -->
  <div class="login-ambient-canvas" aria-hidden="true">
    <div class="ambient-grid"></div>
    <div class="ambient-blob-1"></div>
    <div class="ambient-blob-2"></div>
  </div>

  <!-- ── STAGE 1: Brand Hero Splash ── -->
  <section class="splash-stage" id="splash-stage">
    <div class="splash-content">
      <div class="splash-logo-box">
        <div class="splash-logo-halo"></div>
        <img src="/favicon.png" class="splash-logo-img" alt="Benevolate Integr8">
      </div>

      <div class="splash-wordmark">BENEVOLATE INTEGR8</div>
      <h1 class="splash-tagline">Ship faster.<br>Stay in control.</h1>

      <div>
        <button type="button" class="splash-cta-btn" id="splash-continue-btn" onclick="showAuthStage()">
          <span>Continue</span>
          <i data-lucide="arrow-right" style="width:18px;height:18px;"></i>
        </button>
      </div>

      <footer class="splash-footnote">
        Enterprise Platform &nbsp;&middot;&nbsp; Secure SSO Access &nbsp;&middot;&nbsp; &copy; 2026 Benevolate
      </footer>
    </div>
  </section>

  <!-- ── STAGE 2: Centered Radiant Auth Portal ── -->
  <section class="auth-stage" id="auth-stage" aria-hidden="true">
    <div class="auth-panel-card" id="auth-panel-card">
      <button type="button" class="auth-back-nav" id="auth-back-btn" onclick="handleAuthBack()" title="Back to Overview">
        <i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
      </button>

      <!-- Loading Overlay -->
      <div id="auth-loading-overlay" aria-live="assertive">
        <div class="dual-ring-spinner">
          <div class="spinner-outer"></div>
          <img src="/favicon.png" class="spinner-inner-img" alt="Benevolate Integr8">
        </div>
        <div id="auth-loading-text">Authenticating SSO Workspace...</div>
      </div>

      <!-- Credentials Form View -->
      <div id="login-form-section">
        <div class="auth-brand-block">
          <div class="auth-logo-halo">
            <img src="/favicon.png" class="auth-logo-img" alt="Benevolate Integr8">
          </div>
          <h2 class="auth-title">Benevolate Integr8</h2>
          <p class="auth-subtitle">Sign in to access your organization workspace</p>
        </div>

        <!-- Google Workspace SSO Container -->
        <div class="sso-section">
          <div id="g_id_signin_btn">
            <button type="button" id="google-sso-fallback-btn" class="google-sso-btn" onclick="triggerGoogleSSO()">
              <svg width="18" height="18" viewBox="0 0 18 18">
                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.347 2.825.957 4.039l3.007-2.332z"/>
                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
              </svg>
              <span>Continue with Google Workspace</span>
            </button>
          </div>
        </div>

        <div class="auth-divider">
          <div class="auth-divider-line"></div>
          <span>or sign in with credentials</span>
          <div class="auth-divider-line"></div>
        </div>

        <!-- Credentials Form -->
        <form id="login-form" onsubmit="handleLoginSubmit(event)" novalidate>
          <div class="form-group">
            <label for="login-username" class="form-label">Username</label>
            <div class="input-container">
              <input 
                type="text" 
                id="login-username" 
                name="username"
                class="input-field" 
                placeholder="Enter username..." 
                autocomplete="username" 
                required>
              <i data-lucide="user" class="input-icon-left"></i>
            </div>
          </div>

          <div class="form-group">
            <label for="login-password" class="form-label">Password</label>
            <div class="input-container">
              <input 
                type="password" 
                id="login-password" 
                name="password"
                class="input-field" 
                placeholder="Enter password..." 
                autocomplete="current-password" 
                required>
              <i data-lucide="lock" class="input-icon-left"></i>
              <button 
                type="button" 
                id="toggle-pwd-btn" 
                class="input-btn-right" 
                onclick="togglePasswordVisibility()" 
                title="Toggle password visibility" 
                aria-label="Toggle password visibility">
                <i data-lucide="eye" id="toggle-pwd-icon" style="width:16px;height:16px;"></i>
              </button>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="login-error" class="auth-error-alert" role="alert" aria-live="polite"></div>

          <button type="submit" id="login-submit-btn" class="auth-primary-btn">
            <span>Sign In</span>
            <i data-lucide="arrow-right" style="width:16px;height:16px;"></i>
          </button>
        </form>
      </div>

      <!-- 2FA Challenge View -->
      <div id="twofa-section">
        <div class="twofa-header">
          <div class="twofa-badge-icon">
            <i data-lucide="shield-check" style="width:28px;height:28px;"></i>
          </div>
          <h3 class="twofa-title">Two-Factor Verification</h3>
          <p class="twofa-subtitle">
            Enter the 6-digit security code generated by your Authenticator app.
          </p>
        </div>

        <form id="twofa-form" onsubmit="handle2FASubmit(event)" novalidate>
          <input 
            type="text" 
            id="totp-code" 
            name="totp"
            class="totp-code-field" 
            maxlength="6" 
            placeholder="000 000" 
            inputmode="numeric" 
            autocomplete="one-time-code"
            oninput="this.value=this.value.replace(/[^0-9]/g,'')">

          <div id="twofa-error" class="auth-error-alert" role="alert" aria-live="polite"></div>

          <button type="submit" id="twofa-submit-btn" class="auth-primary-btn" disabled>
            <span>Verify Security Code</span>
            <i data-lucide="check" style="width:16px;height:16px;"></i>
          </button>
        </form>
      </div>
    </div>
  </section>

  <script src="/js/api.js"></script>
  <script src="/js/auth.js"></script>
  <script>
    var pending2FA = null;
    var GOOGLE_CLIENT_ID = '1018746602979-blog5afpgc9iv4ke0gllpam30v5fs8b7.apps.googleusercontent.com';

    // ── 30-Minute Dynamic Theme Engine ──
    var PALETTES = [
      { id: 'indigo',  name: 'Electric Indigo' },
      { id: 'aurora',  name: 'Aurora Cyan' },
      { id: 'emerald', name: 'Cyber Emerald' },
      { id: 'solar',   name: 'Solar Forge' },
      { id: 'crimson', name: 'Crimson Stealth' }
    ];

    function get30MinuteThemeIndex() {
      // Computes deterministic 30-minute block from UTC clock
      var current30MinBlock = Math.floor(Date.now() / (30 * 60 * 1000));
      return current30MinBlock % PALETTES.length;
    }

    function applyAutoTheme() {
      var manualOverride = localStorage.getItem('benevolate-manual-palette');
      var palette = manualOverride ? PALETTES.find(p => p.id === manualOverride) : null;
      if (!palette) {
        var idx = get30MinuteThemeIndex();
        palette = PALETTES[idx];
      }
      setPalette(palette.id, false);
    }

    function setPalette(id, isManual) {
      var palette = PALETTES.find(p => p.id === id) || PALETTES[0];
      document.documentElement.setAttribute('data-palette', palette.id);
      var label = document.getElementById('theme-name-label');
      if (label) label.textContent = 'Theme: ' + palette.name;

      if (isManual) {
        localStorage.setItem('benevolate-manual-palette', palette.id);
      }
    }

    function cycleNextPalette() {
      var currentId = document.documentElement.getAttribute('data-palette') || 'indigo';
      var currentIndex = PALETTES.findIndex(p => p.id === currentId);
      var nextIndex = (currentIndex + 1) % PALETTES.length;
      setPalette(PALETTES[nextIndex].id, true);
    }

    // Auto-update theme on exact 30-minute intervals
    setInterval(applyAutoTheme, 60000); // Checks every minute for 30m boundary

    document.addEventListener('DOMContentLoaded', function() {
      applyAutoTheme();

      if (window.lucide) {
        lucide.createIcons();
      }

      initGoogleSSO();

      // TOTP Code auto-unlock
      var totpInput = document.getElementById('totp-code');
      if (totpInput) {
        totpInput.addEventListener('input', function() {
          var btn = document.getElementById('twofa-submit-btn');
          if (this.value.length === 6) {
            btn.disabled = false;
            if (window.Motion) {
              Motion.animate(btn, { scale: [0.97, 1] }, { duration: 0.2, type: 'spring' });
            }
          } else {
            btn.disabled = true;
          }
        });
      }

      // Entrance motion
      if (window.Motion) {
        Motion.animate('.splash-content', { opacity: [0, 1], y: [20, 0] }, { duration: 0.5, ease: 'easeOut' });
      }
    });

    // ── Stage 1 -> Stage 2 Transitions (Spring Motion) ──
    function showAuthStage() {
      var splash = document.getElementById('splash-stage');
      var authStage = document.getElementById('auth-stage');
      var card = document.getElementById('auth-panel-card');

      if (window.Motion) {
        Motion.animate(splash, { opacity: [1, 0], scale: [1, 0.96] }, { duration: 0.35 }).finished.then(function() {
          splash.classList.add('hidden');
          authStage.classList.add('visible');
          authStage.setAttribute('aria-hidden', 'false');
          Motion.animate(card, { opacity: [0, 1], y: [24, 0], scale: [0.98, 1] }, { duration: 0.4, type: 'spring', stiffness: 300, damping: 25 });
          initGoogleSSO();
          document.getElementById('login-username').focus();
        });
      } else {
        splash.classList.add('hidden');
        authStage.classList.add('visible');
        authStage.setAttribute('aria-hidden', 'false');
        initGoogleSSO();
        document.getElementById('login-username').focus();
      }
    }

    function handleAuthBack() {
      if (pending2FA) {
        pending2FA = null;
        var totp = document.getElementById('totp-code');
        if (totp) totp.value = '';
        var err = document.getElementById('twofa-error');
        if (err) err.style.display = 'none';

        var twofaSection = document.getElementById('twofa-section');
        var loginSection = document.getElementById('login-form-section');

        if (window.Motion) {
          Motion.animate(twofaSection, { opacity: [1, 0], x: [0, 20] }, { duration: 0.25 }).finished.then(function() {
            twofaSection.style.display = 'none';
            loginSection.style.display = 'block';
            Motion.animate(loginSection, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.3, type: 'spring' });
            initGoogleSSO();
          });
        } else {
          twofaSection.style.display = 'none';
          loginSection.style.display = 'block';
          initGoogleSSO();
        }
      } else {
        var splash = document.getElementById('splash-stage');
        var authStage = document.getElementById('auth-stage');
        var card = document.getElementById('auth-panel-card');

        if (window.Motion) {
          Motion.animate(card, { opacity: [1, 0], y: [0, 20], scale: [1, 0.98] }, { duration: 0.3 }).finished.then(function() {
            authStage.classList.remove('visible');
            authStage.setAttribute('aria-hidden', 'true');
            splash.classList.remove('hidden');
            Motion.animate(splash, { opacity: [0, 1], scale: [0.96, 1] }, { duration: 0.35 });
          });
        } else {
          authStage.classList.remove('visible');
          authStage.setAttribute('aria-hidden', 'true');
          splash.classList.remove('hidden');
        }
      }
    }

    function togglePasswordVisibility() {
      var pwdInput = document.getElementById('login-password');
      var icon = document.getElementById('toggle-pwd-icon');
      if (!pwdInput) return;

      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        if (icon) icon.setAttribute('data-lucide', 'eye-off');
      } else {
        pwdInput.type = 'password';
        if (icon) icon.setAttribute('data-lucide', 'eye');
      }
      if (window.lucide) lucide.createIcons();
    }

    function showError(elId, msg) {
      var el = document.getElementById(elId);
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';

      if (window.Motion) {
        Motion.animate(el, { x: [-8, 8, -4, 4, 0] }, { duration: 0.35 });
      }
    }

    async function handleLoginSubmit(e) {
      e.preventDefault();
      var username = document.getElementById('login-username').value.trim();
      var password = document.getElementById('login-password').value;
      if (!username || !password) {
        return showError('login-error', 'Please provide both username and password');
      }

      var btn = document.getElementById('login-submit-btn');
      var originalBtnContent = btn.innerHTML;
      btn.innerHTML = '<span class="animate-spin" style="display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;"></span><span>Signing In...</span>';
      btn.disabled = true;
      document.getElementById('login-error').style.display = 'none';

      try {
        var res = await auth.login(username, password);
        if (res.ok) {
          if (res.require2FA) {
            pending2FA = { tempToken: res.tempToken, username: res.username };
            var loginSection = document.getElementById('login-form-section');
            var twofaSection = document.getElementById('twofa-section');

            if (window.Motion) {
              Motion.animate(loginSection, { opacity: [1, 0], x: [0, -20] }, { duration: 0.25 }).finished.then(function() {
                loginSection.style.display = 'none';
                twofaSection.style.display = 'block';
                Motion.animate(twofaSection, { opacity: [0, 1], x: [20, 0] }, { duration: 0.3, type: 'spring' });
                if (window.lucide) lucide.createIcons();
                document.getElementById('totp-code').focus();
              });
            } else {
              loginSection.style.display = 'none';
              twofaSection.style.display = 'block';
              if (window.lucide) lucide.createIcons();
              document.getElementById('totp-code').focus();
            }
          } else {
            window.location.href = res.isProfileCompleted === false ? '/settings' : '/';
          }
        } else {
          showError('login-error', res.error || 'Authentication credentials rejected');
        }
      } catch (err) {
        showError('login-error', 'Connection error occurred during sign-in');
      } finally {
        btn.innerHTML = originalBtnContent;
        btn.disabled = false;
        if (window.lucide) lucide.createIcons();
      }
    }

    async function handle2FASubmit(e) {
      e.preventDefault();
      var code = document.getElementById('totp-code').value.trim();
      if (!code || code.length !== 6) {
        return showError('twofa-error', 'Enter a valid 6-digit verification code');
      }

      var btn = document.getElementById('twofa-submit-btn');
      var originalBtnContent = btn.innerHTML;
      btn.innerHTML = '<span class="animate-spin" style="display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;"></span><span>Verifying...</span>';
      btn.disabled = true;
      document.getElementById('twofa-error').style.display = 'none';

      try {
        var res = await auth.verify2FA(pending2FA.tempToken, code);
        if (res.ok) {
          window.location.href = res.isProfileCompleted === false ? '/settings' : '/';
        } else {
          showError('twofa-error', res.error || 'Verification code invalid or expired');
        }
      } catch (err) {
        showError('twofa-error', 'Network error during code verification');
      } finally {
        btn.innerHTML = originalBtnContent;
        btn.disabled = false;
        if (window.lucide) lucide.createIcons();
      }
    }

    var _gsoAttempts = 0;
    function triggerGoogleSSO() {
      if (window.google && window.google.accounts && window.google.accounts.id) {
        window.google.accounts.id.prompt();
      } else {
        initGoogleSSO();
      }
    }

    function initGoogleSSO() {
      if (!window.google || !window.google.accounts || !window.google.accounts.id) {
        _gsoAttempts++;
        if (_gsoAttempts < 35) {
          setTimeout(initGoogleSSO, 120);
        }
        return;
      }
      try {
        window.google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: async function(response) {
            if (response && response.credential) {
              var overlay = document.getElementById('auth-loading-overlay');
              if (overlay) overlay.style.display = 'flex';
              try {
                var res = await auth.loginWithGoogle(response.credential);
                if (res.ok) {
                  if (res.require2FA) {
                    if (overlay) overlay.style.display = 'none';
                    pending2FA = { tempToken: res.tempToken, username: res.username };
                    var loginSection = document.getElementById('login-form-section');
                    var twofaSection = document.getElementById('twofa-section');
                    loginSection.style.display = 'none';
                    twofaSection.style.display = 'block';
                    if (window.lucide) lucide.createIcons();
                    document.getElementById('totp-code').focus();
                  } else {
                    var txt = document.getElementById('auth-loading-text');
                    if (txt) txt.textContent = 'Workspace Verified. Redirecting...';
                    window.location.href = res.isProfileCompleted === false ? '/settings' : '/';
                  }
                } else {
                  if (overlay) overlay.style.display = 'none';
                  showError('login-error', res.error || 'Google Workspace sign-in failed');
                }
              } catch (err) {
                if (overlay) overlay.style.display = 'none';
                showError('login-error', 'SSO network error occurred');
              }
            }
          }
        });
        
        var btnContainer = document.getElementById('g_id_signin_btn');
        if (btnContainer) {
          var card = document.getElementById('auth-panel-card');
          var targetWidth = card ? Math.min(card.clientWidth - 72, 368) : 368;
          btnContainer.innerHTML = '';
          window.google.accounts.id.renderButton(btnContainer, {
            type: 'standard',
            shape: 'pill',
            theme: 'filled_black',
            text: 'continue_with',
            size: 'large',
            logo_alignment: 'left',
            width: targetWidth
          });
        }
      } catch(err) {
        console.error('Google SSO init failed:', err);
      }
    }
  </script>
</body>
</html>
