<div class="monitoring-container">
  <% if (user.userType !== 'devops' && user.userType !== 'admin' && user.userType !== 'super_admin') { %>
    <div style="text-align:center;padding:80px 20px;">
      <div style="width:56px;height:56px;border-radius:16px;background:rgba(239,68,68,0.1);color:#ef4444;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <i data-lucide="shield-alert" style="width:28px;height:28px;"></i>
      </div>
      <h2 style="font-size:20px;font-weight:700;color:var(--color-text-primary);margin-bottom:8px;">Access Restricted</h2>
      <p style="font-size:14px;color:var(--color-text-secondary);max-width:440px;margin:0 auto;">
        You do not have permission to access this page. Please contact your organization administrator.
      </p>
    </div>
  <% } else { %>

    <!-- Header -->
    <div class="monitoring-header">
      <div>
        <h1 style="font-size:22px;font-weight:700;color:var(--color-text-primary);margin-bottom:4px;">Live Infrastructure Monitoring</h1>
        <p style="font-size:13px;color:var(--color-text-secondary);">Real-time health, CPU/Memory utilization, and service metrics.</p>
      </div>
      <button onclick="fetchHealthMetrics()" id="refresh-monitoring-btn"
        style="padding:8px 14px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;font-size:13px;display:flex;align-items:center;gap:6px;color:var(--color-text-primary);font-weight:600;">
        <i data-lucide="refresh-cw" id="refresh-icon" style="width:14px;height:14px;"></i> Refresh
      </button>
    </div>

    <!-- Metric Cards -->
    <div class="monitoring-grid">
      <div class="monitoring-card">
        <div class="monitoring-card-label">API SERVER STATUS</div>
        <div class="monitoring-card-value" style="color:var(--color-success);">ONLINE (200 OK)</div>
      </div>
      <div class="monitoring-card">
        <div class="monitoring-card-label">DATABASE POOL</div>
        <div class="monitoring-card-value" id="mon-db-status" style="color:var(--color-text-primary);">Checking...</div>
      </div>
      <div class="monitoring-card">
        <div class="monitoring-card-label">AWS STS IDENTITY</div>
        <div class="monitoring-card-value" id="mon-aws-status" style="color:var(--color-text-primary);">Checking...</div>
      </div>
    </div>

    <!-- ── Unified ECS Log Viewer ──────────────────────────────────────────── -->
    <div style="margin-top:32px;">

      <!-- Section header with mode toggle -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:10px;">
          <i data-lucide="terminal" style="width:18px;height:18px;color:var(--color-primary);"></i>
          <h2 style="font-size:18px;font-weight:700;color:var(--color-text-primary);margin:0;">ECS Task Logs</h2>
        </div>
        <div class="log-mode-toggle">
          <button class="log-mode-btn active" id="mode-live-btn" onclick="switchLogMode('live')">
            <i data-lucide="activity" style="width:13px;height:13px;"></i> Live Stream
          </button>
          <button class="log-mode-btn" id="mode-search-btn" onclick="switchLogMode('search')">
            <i data-lucide="search" style="width:13px;height:13px;"></i> Search Logs
          </button>
        </div>
      </div>

      <!-- Single card wrapping both modes -->
      <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;overflow:hidden;">

        <!-- ── LIVE MODE ──────────────────────────────────────────── -->
        <div id="panel-live">
          <div style="padding:10px 14px;background:var(--color-bg);border-bottom:1px solid var(--color-border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
              <span style="font-size:11px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.05em;">ENV</span>
              <div class="log-pill-group">
                <button class="log-env-btn active" data-env="dev">Dev</button>
                <button class="log-env-btn" data-env="uat">UAT</button>
                <button class="log-env-btn" data-env="prod">Prod</button>
                <button class="log-env-btn" data-env="beta">Beta</button>
              </div>
              <div style="width:1px;height:22px;background:var(--color-border);"></div>
              <span style="font-size:11px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.05em;">FILTER</span>
              <div class="log-pill-group">
                <button class="log-type-btn active" data-type="all">All</button>
                <button class="log-type-btn" data-type="error">App Errors</button>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <span id="log-status-indicator" style="font-size:12px;color:var(--color-text-secondary);display:flex;align-items:center;gap:5px;">
                <span style="width:7px;height:7px;border-radius:50%;background:var(--color-text-tertiary);display:inline-block;"></span>Waiting...
              </span>
              <button id="logs-play-pause-btn" class="log-action-btn">
                <i data-lucide="pause" style="width:13px;height:13px;"></i> Pause
              </button>
              <button id="logs-clear-btn" class="log-action-btn">
                <i data-lucide="trash-2" style="width:13px;height:13px;"></i> Clear
              </button>
            </div>
          </div>
          <div id="log-terminal" style="height:520px;background:#0d1117;color:#c9d1d9;padding:16px;font-family:'JetBrains Mono',Consolas,monospace;font-size:12.5px;overflow-y:auto;white-space:pre-wrap;line-height:1.6;">
            <div style="color:#8b949e;text-align:center;margin-top:60px;font-size:13px;">Select an environment to view live ECS task logs...</div>
          </div>
        </div>

        <!-- ── SEARCH MODE ─────────────────────────────────────────── -->
        <div id="panel-search" style="display:none;">

          <!-- Filter Bar -->
          <div style="padding:18px 20px;background:var(--color-bg);border-bottom:1px solid var(--color-border);">
            <!-- Env row -->
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
              <span style="font-size:11px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.05em;min-width:32px;">ENV</span>
              <div class="log-pill-group">
                <button class="ls-env-btn active" data-env="dev">Dev</button>
                <button class="ls-env-btn" data-env="uat">UAT</button>
                <button class="ls-env-btn" data-env="prod">Prod</button>
                <button class="ls-env-btn" data-env="beta">Beta</button>
              </div>
            </div>
            <!-- Input fields row -->
            <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
              <div class="ls-field">
                <label class="ls-label">FROM (CST)</label>
                <input type="datetime-local" id="ls-from" class="ls-input">
              </div>
              <div class="ls-field">
                <label class="ls-label">TO (CST)</label>
                <input type="datetime-local" id="ls-to" class="ls-input">
              </div>
              <div class="ls-field">
                <label class="ls-label">Category</label>
                <select id="ls-category" class="ls-input" style="min-width:110px;cursor:pointer;">
                  <option value="">All</option>
                  <option value="error">Error</option>
                  <option value="warn">Warning</option>
                  <option value="info">Info</option>
                </select>
              </div>
              <div class="ls-field" style="flex:1;min-width:220px;">
                <label class="ls-label">Text (message / route / tag)</label>
                <div style="position:relative;">
                  <i data-lucide="search" style="width:13px;height:13px;position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--color-text-tertiary);pointer-events:none;"></i>
                  <input type="text" id="ls-text" placeholder="message, route, keyword..." class="ls-input" style="padding-left:30px;width:100%;box-sizing:border-box;">
                </div>
              </div>
              <div style="display:flex;gap:8px;align-items:flex-end;padding-bottom:1px;">
                <button id="ls-search-btn" onclick="runLogSearch()" class="ls-btn-primary">
                  <i data-lucide="search" style="width:13px;height:13px;"></i> Search
                </button>
                <button onclick="lsReset()" class="ls-btn-ghost">
                  <i data-lucide="rotate-ccw" style="width:13px;height:13px;"></i> Reset
                </button>
              </div>
            </div>
          </div>

          <!-- Results Area -->
          <div id="ls-results-area" style="min-height:360px;">
            <div id="ls-placeholder" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;color:var(--color-text-tertiary);">
              <i data-lucide="file-search" style="width:40px;height:40px;margin-bottom:14px;opacity:0.35;"></i>
              <div style="font-size:14px;font-weight:600;margin-bottom:4px;">No search yet</div>
              <div style="font-size:13px;">Set your filters above and click <strong>Search</strong></div>
            </div>
            <div id="ls-loading" style="display:none;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;color:var(--color-text-secondary);">
              <div style="width:34px;height:34px;border:3px solid var(--color-border);border-top-color:var(--color-primary);border-radius:50%;animation:spin 0.75s linear infinite;margin-bottom:14px;"></div>
              <div style="font-size:13px;">Querying CloudWatch logs...</div>
            </div>
            <div id="ls-table-wrap" style="display:none;">
              <div style="padding:10px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-border);background:var(--color-bg);">
                <span id="ls-result-count" style="font-size:12px;font-weight:600;color:var(--color-text-secondary);"></span>
                <button id="ls-load-more-btn" onclick="loadMoreLogs()" style="display:none;padding:5px 14px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:6px;font-size:12px;font-weight:600;color:var(--color-text-primary);cursor:pointer;">Load More</button>
              </div>
              <div style="overflow-x:auto;">
                <table class="ls-table">
                  <thead>
                    <tr>
                      <th>WHEN</th>
                      <th style="width:76px;">CAT</th>
                      <th style="width:160px;">STREAM</th>
                      <th>MESSAGE</th>
                    </tr>
                  </thead>
                  <tbody id="ls-table-body"></tbody>
                </table>
              </div>
            </div>
            <div id="ls-empty" style="display:none;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;color:var(--color-text-tertiary);">
              <i data-lucide="inbox" style="width:40px;height:40px;margin-bottom:14px;opacity:0.35;"></i>
              <div style="font-size:14px;font-weight:600;margin-bottom:4px;">No results found</div>
              <div style="font-size:13px;">Try widening the date range or removing the keyword filter.</div>
            </div>
            <div id="ls-error" style="display:none;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;color:var(--color-danger);">
              <i data-lucide="alert-triangle" style="width:36px;height:36px;margin-bottom:12px;opacity:0.7;"></i>
              <div id="ls-error-msg" style="font-size:13px;text-align:center;max-width:400px;"></div>
            </div>
          </div>

        </div><!-- /panel-search -->
      </div><!-- /card -->
    </div><!-- /section -->

  <% } %>
</div>

<style>
  .log-pill-group {
    display: flex; gap: 3px;
    background: var(--color-surface); padding: 3px;
    border-radius: 8px; border: 1px solid var(--color-border);
  }
  .log-env-btn, .log-type-btn, .ls-env-btn {
    padding: 5px 14px; background: transparent; border: none;
    border-radius: 6px; cursor: pointer; font-size: 12.5px; font-weight: 600;
    color: var(--color-text-secondary); transition: all 0.15s; white-space: nowrap;
  }
  .log-env-btn:hover, .log-type-btn:hover, .ls-env-btn:hover { background: var(--color-bg); color: var(--color-text-primary); }
  .log-env-btn.active, .log-type-btn.active, .ls-env-btn.active { background: var(--color-primary); color: #fff; }

  .log-mode-toggle {
    display: flex; gap: 3px; background: var(--color-surface);
    padding: 3px; border-radius: 8px; border: 1px solid var(--color-border);
  }
  .log-mode-btn {
    padding: 6px 14px; background: transparent; border: none; border-radius: 6px;
    cursor: pointer; font-size: 12.5px; font-weight: 600; color: var(--color-text-secondary);
    display: flex; align-items: center; gap: 5px; transition: all 0.15s;
  }
  .log-mode-btn:hover { background: var(--color-bg); color: var(--color-text-primary); }
  .log-mode-btn.active { background: var(--color-primary); color: #fff; }

  .log-action-btn {
    padding: 5px 11px; background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;
    color: var(--color-text-primary); display: flex; align-items: center; gap: 5px; transition: background 0.15s;
  }
  .log-action-btn:hover { background: var(--color-surface); }

  .ls-field { display: flex; flex-direction: column; gap: 5px; }
  .ls-label { font-size: 10.5px; font-weight: 700; color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: .06em; }
  .ls-input {
    padding: 8px 10px; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 8px; color: var(--color-text-primary); font-size: 13px;
    font-family: var(--font-family); outline: none; transition: border-color .15s, box-shadow .15s;
  }
  .ls-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(99,102,241,.15); }

  .ls-btn-primary {
    padding: 8px 18px; background: var(--color-primary); border: none; border-radius: 8px;
    color: #fff; font-size: 13px; font-weight: 700; cursor: pointer;
    display: flex; align-items: center; gap: 6px; white-space: nowrap; transition: opacity .15s;
  }
  .ls-btn-primary:disabled { opacity: .55; cursor: not-allowed; }
  .ls-btn-ghost {
    padding: 8px 14px; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 8px; color: var(--color-text-secondary); font-size: 13px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; gap: 5px; transition: all .15s;
  }
  .ls-btn-ghost:hover { color: var(--color-text-primary); background: var(--color-bg); }

  .ls-table { width: 100%; border-collapse: collapse; }
  .ls-table thead tr { background: var(--color-bg); }
  .ls-table th {
    padding: 9px 14px; text-align: left; font-size: 11px; font-weight: 700;
    color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: .06em;
    border-bottom: 1px solid var(--color-border); white-space: nowrap;
  }
  .ls-table th:first-child { padding-left: 20px; }
  .ls-table th:last-child  { padding-right: 20px; }
  .ls-table tbody tr { border-bottom: 1px solid var(--color-border); transition: background .1s; }
  .ls-table tbody tr:hover { background: rgba(99,102,241,.04); }
  .ls-table td { padding: 9px 14px; font-size: 12.5px; vertical-align: top; color: var(--color-text-secondary); }
  .ls-table td:first-child { padding-left: 20px; white-space: nowrap; font-family: monospace; }
  .ls-table td:last-child  { padding-right: 20px; word-break: break-all; color: var(--color-text-primary); font-family: monospace; line-height: 1.55; }

  .ls-badge { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; white-space: nowrap; }
  .ls-badge-error { background: rgba(239,68,68,.14);  color: #f87171; }
  .ls-badge-warn  { background: rgba(245,158,11,.14); color: #fbbf24; }
  .ls-badge-info  { background: rgba(99,102,241,.14); color: #818cf8; }
  .ls-badge-other { background: rgba(148,163,184,.1); color: #94a3b8; }

  .ls-stream { display: inline-block; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; font-family: monospace; color: var(--color-text-tertiary); }

  #ls-loading, #ls-empty, #ls-error { display: flex; }
  input[type="datetime-local"]::-webkit-calendar-picker-indicator { filter: invert(.6); cursor: pointer; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
// ── Mode Switch ────────────────────────────────────────────────────────────
function switchLogMode(mode) {
  const live = mode === 'live';
  document.getElementById('panel-live').style.display   = live ? '' : 'none';
  document.getElementById('panel-search').style.display = live ? 'none' : '';
  document.getElementById('mode-live-btn').classList.toggle('active', live);
  document.getElementById('mode-search-btn').classList.toggle('active', !live);
  if (!live) _lsInitDefaults();
}

// ── Log Search ─────────────────────────────────────────────────────────────
let _lsEnv = 'dev', _lsNextToken = null, _lsTotalRows = 0;

function _lsInitDefaults() {
  const now = new Date(), from = new Date(now - 864e5);
  const fmt = d => d.toISOString().slice(0, 16);
  const fe = document.getElementById('ls-from'), te = document.getElementById('ls-to');
  if (fe && !fe.value) fe.value = fmt(from);
  if (te && !te.value) te.value = fmt(now);
}

document.querySelectorAll('.ls-env-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.ls-env-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    _lsEnv = btn.dataset.env;
  });
});
document.getElementById('ls-text')?.addEventListener('keydown', e => { if (e.key === 'Enter') runLogSearch(); });

function _lsShowOnly(id) {
  ['ls-placeholder','ls-loading','ls-table-wrap','ls-empty','ls-error'].forEach(el => {
    const node = document.getElementById(el);
    if (!node) return;
    const flex = ['ls-loading','ls-empty','ls-error'].includes(el);
    node.style.display = el === id ? (flex ? 'flex' : '') : 'none';
  });
}

function _lsCat(msg) {
  const m = msg.toLowerCase();
  if (m.includes('error') || m.includes('exception') || m.includes('fatal') || m.includes('fail')) return 'error';
  if (m.includes('warn') || m.includes('warning') || m.includes('deprecated')) return 'warn';
  if (m.includes('info') || m.includes('notice') || m.includes('listening') || m.includes('started')) return 'info';
  return 'other';
}

function _lsRenderRows(events, append) {
  const tbody = document.getElementById('ls-table-body');
  if (!tbody) return;
  if (!append) tbody.innerHTML = '';
  const catFilter = document.getElementById('ls-category')?.value || '';
  events.forEach(e => {
    const cat = _lsCat(e.message);
    if (catFilter && cat !== catFilter) return;
    const ts     = new Date(e.timestamp).toLocaleString(undefined, { month:'short', day:'2-digit', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12: false });
    const stream = (e.logStreamName || '').split('/').pop() || '—';
    const msg    = e.message.replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${ts}</td><td><span class="ls-badge ls-badge-${cat}">${cat}</span></td><td><span class="ls-stream" title="${e.logStreamName||''}">${stream}</span></td><td>${msg}</td>`;
    tbody.appendChild(tr);
    _lsTotalRows++;
  });
}

async function runLogSearch(append) {
  if (!append) { _lsNextToken = null; _lsTotalRows = 0; }
  const projectId = _cachedProjectId;
  if (!projectId) {
    _lsShowOnly('ls-error');
    document.getElementById('ls-error-msg').textContent = 'No active project. Switch from the top-left dropdown.';
    return;
  }
  const fromVal = document.getElementById('ls-from')?.value;
  const toVal   = document.getElementById('ls-to')?.value;
  const text    = (document.getElementById('ls-text')?.value || '').trim();
  const params  = new URLSearchParams();
  if (fromVal) params.set('startTime', new Date(fromVal).getTime());
  if (toVal)   params.set('endTime',   new Date(toVal).getTime());
  if (text)    params.set('filterPattern', text);
  if (_lsNextToken) params.set('nextToken', _lsNextToken);

  const btn = document.getElementById('ls-search-btn');
  const lmb = document.getElementById('ls-load-more-btn');
  if (!append) { _lsShowOnly('ls-loading'); if (btn) btn.disabled = true; }
  if (lmb) { lmb.style.display = 'none'; lmb.disabled = true; }

  try {
    const data = await api.get(`/api/logs/search/${projectId}/${_lsEnv}?${params}`);
    if (!data?.ok) throw new Error(data?.error || 'Server error');
    if (data.notFound || (!data.events?.length && !append)) { _lsShowOnly('ls-empty'); return; }
    _lsNextToken = data.nextToken || null;
    _lsRenderRows(data.events || [], append);
    _lsShowOnly('ls-table-wrap');
    const countEl = document.getElementById('ls-result-count');
    if (countEl) countEl.textContent = `${_lsTotalRows} result${_lsTotalRows !== 1 ? 's' : ''}${_lsNextToken ? ' · more available' : ''}`;
    if (lmb) { lmb.style.display = _lsNextToken ? '' : 'none'; lmb.disabled = false; }
  } catch (err) {
    _lsShowOnly('ls-error');
    document.getElementById('ls-error-msg').textContent = `Search failed: ${err.message}`;
  } finally {
    if (btn) btn.disabled = false;
  }
}

function loadMoreLogs() { if (_lsNextToken) runLogSearch(true); }

function lsReset() {
  ['ls-from','ls-to','ls-text'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  const ca = document.getElementById('ls-category'); if (ca) ca.value = '';
  _lsNextToken = null; _lsTotalRows = 0;
  _lsInitDefaults();
  _lsShowOnly('ls-placeholder');
  const lmb = document.getElementById('ls-load-more-btn'); if (lmb) lmb.style.display = 'none';
}
</script>