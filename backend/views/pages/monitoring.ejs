<div class="monitoring-container">
<% if (user.userType !== 'devops' && user.userType !== 'admin' && user.userType !== 'super_admin') { %>
  <div style="text-align:center;padding:80px 20px;">
    <div style="width:56px;height:56px;border-radius:16px;background:rgba(239,68,68,0.1);color:#ef4444;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
      <i data-lucide="shield-alert" style="width:28px;height:28px;"></i>
    </div>
    <h2 style="font-size:20px;font-weight:700;color:var(--color-text-primary);margin-bottom:8px;">Access Restricted</h2>
    <p style="font-size:14px;color:var(--color-text-secondary);max-width:440px;margin:0 auto;">
      You do not have permission to access this page. Please contact your organization administrator if you believe this is an error.
    </p>
  </div>
<% } else { %>
  <!-- Header -->
  <div class="monitoring-header">
    <div>
      <h1 style="font-size:22px;font-weight:700;color:var(--color-text-primary);margin-bottom:4px;">
        Live Infrastructure Monitoring
      </h1>
      <p style="font-size:13px;color:var(--color-text-secondary);">
        Real-time health, CPU/Memory utilization, and service metrics.
      </p>
    </div>
    <button onclick="fetchHealthMetrics()" id="refresh-monitoring-btn" style="padding:8px 14px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;font-size:13px;display:flex;align-items:center;gap:6px;color:var(--color-text-primary);font-weight:600;">
      <i data-lucide="refresh-cw" id="refresh-icon" style="width:14px;height:14px;"></i> Refresh
    </button>
  </div>

  <!-- Metric Cards Grid -->
  <div class="monitoring-grid">
    <!-- API Server Status -->
    <div class="monitoring-card">
      <div class="monitoring-card-label">API SERVER STATUS</div>
      <div class="monitoring-card-value" style="color:var(--color-success);">ONLINE (200 OK)</div>
    </div>

    <!-- Database Pool -->
    <div class="monitoring-card">
      <div class="monitoring-card-label">DATABASE POOL</div>
      <div class="monitoring-card-value" id="mon-db-status" style="color:var(--color-text-primary);">Checking...</div>
    </div>

    <!-- AWS STS Identity -->
    <div class="monitoring-card">
      <div class="monitoring-card-label">AWS STS IDENTITY</div>
      <div class="monitoring-card-value" id="mon-aws-status" style="color:var(--color-text-primary);">Checking...</div>
    </div>
  </div>

  <!-- ECS Task Log Viewer -->
  <div style="margin-top: 32px;">
    <h2 style="font-size:18px;font-weight:700;color:var(--color-text-primary);margin-bottom:12px;display:flex;align-items:center;gap:8px;">
      <i data-lucide="terminal" style="width:18px;height:18px;color:var(--color-primary);"></i>
      ECS Task Logs (Application & Server)
    </h2>
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;height:600px;">
      <!-- Log Controls -->
      <div style="padding:12px 16px;background:var(--color-bg);border-bottom:1px solid var(--color-border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:12px;">
          <span style="font-size:12px;font-weight:600;color:var(--color-text-secondary);">ENVIRONMENT:</span>
          <div style="display:flex;gap:4px;background:var(--color-surface);padding:4px;border-radius:8px;border:1px solid var(--color-border);">
            <button class="log-env-btn active" data-env="dev">Dev</button>
            <button class="log-env-btn" data-env="uat">UAT</button>
            <button class="log-env-btn" data-env="prod">Prod</button>
            <button class="log-env-btn" data-env="beta">Beta</button>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
          <span id="log-status-indicator" style="font-size:12px;color:var(--color-text-secondary);display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:var(--color-text-tertiary);display:inline-block;"></span> Waiting...
          </span>
          <button id="logs-play-pause-btn" style="padding:6px 12px;background:var(--color-bg);border:1px solid var(--color-border);border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;color:var(--color-text-primary);display:flex;align-items:center;gap:6px;">
            <i data-lucide="pause" style="width:14px;height:14px;"></i> Pause
          </button>
          <button id="logs-clear-btn" style="padding:6px 12px;background:var(--color-bg);border:1px solid var(--color-border);border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;color:var(--color-text-primary);display:flex;align-items:center;gap:6px;">
            <i data-lucide="trash-2" style="width:14px;height:14px;"></i> Clear
          </button>
        </div>
      </div>
      
      <!-- Log Terminal -->
      <div id="log-terminal" style="flex:1;background:#0d1117;color:#c9d1d9;padding:16px;font-family:monospace;font-size:13px;overflow-y:auto;white-space:pre-wrap;line-height:1.5;">
        <div style="color:#8b949e;text-align:center;margin-top:40px;">Select an environment to view live ECS task logs...</div>
      </div>
    </div>
  </div>
<% } %>
</div>

<style>
.log-env-btn {
  padding: 6px 16px;
  background: transparent;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}
.log-env-btn:hover {
  background: var(--color-bg);
  color: var(--color-text-primary);
}
.log-env-btn.active {
  background: var(--color-primary);
  color: #fff;
}
</style>
