            </span>
            <span id="provider-selected-text" style="font-weight:700;font-size:14px;color:var(--color-text-primary);">
              AWS CodeCommit
            </span>
          </div>
          <i data-lucide="chevron-down" style="width:14px;height:14px;color:var(--color-text-tertiary);"></i>
        </div>

        <div id="modal-provider-dropdown" class="modal-provider-dropdown" style="display:none;">
          <div onclick="selectConnProvider('codecommit')" class="modal-provider-option">
            <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#FF9900" d="M6.763 10.036c0 .296.032.535.088.71.064.176.144.368.256.576.04.064.056.128.056.184 0 .08-.048.16-.152.24l-.504.336a.383.383 0 0 1-.208.072c-.08 0-.16-.04-.24-.112a2.47 2.47 0 0 1-.288-.376 6.18 6.18 0 0 1-.248-.472c-.624.736-1.408 1.104-2.352 1.104-.672 0-1.208-.192-1.6-.576-.392-.384-.592-.896-.592-1.536 0-.68.24-1.232.728-1.648.488-.416 1.136-.624 1.96-.624.272 0 .552.024.848.064.296.04.6.104.92.176v-.584c0-.608-.128-1.032-.376-1.28-.256-.248-.688-.368-1.304-.368-.28 0-.568.032-.864.104-.296.072-.584.168-.864.296a2.298 2.298 0 0 1-.28.104.488.488 0 0 1-.128.024c-.112 0-.168-.08-.168-.248v-.392c0-.128.016-.224.056-.28a.597.597 0 0 1 .224-.168c.28-.144.616-.264 1.008-.36A4.84 4.84 0 0 1 4.8 6.6c.952 0 1.648.216 2.096.648.44.432.664 1.088.664 1.968v2.82zm-3.24 1.212c.264 0 .536-.048.824-.144.288-.096.544-.272.76-.512.128-.152.224-.32.272-.512.048-.192.08-.424.08-.696v-.336a6.709 6.709 0 0 0-.736-.136 6.02 6.02 0 0 0-.752-.048c-.536 0-.928.104-1.192.32-.264.216-.392.52-.392.92 0 .376.096.656.296.848.192.2.464.296.84.296zm6.44.864c-.144 0-.24-.024-.304-.08-.064-.048-.12-.16-.168-.312L7.58 7.616a1.42 1.42 0 0 1-.072-.32c0-.128.064-.2.192-.2h.784c.152 0 .256.024.312.08.064.048.112.16.16.312l1.48 5.836 1.376-5.836c.04-.16.088-.264.152-.312a.56.56 0 0 1 .32-.08h.64c.152 0 .256.024.32.08.064.048.12.16.152.312l1.392 5.904 1.528-5.904c.048-.16.104-.264.16-.312a.52.52 0 0 1 .312-.08h.744c.128 0 .2.064.2.2 0 .04-.008.08-.016.128a1.137 1.137 0 0 1-.056.2l-2.128 6.104c-.048.16-.104.264-.168.312a.51.51 0 0 1-.304.08h-.688c-.152 0-.256-.024-.32-.08-.064-.056-.12-.16-.152-.32L12.96 7.964l-1.368 5.836c-.04.16-.088.264-.152.32-.064.056-.176.08-.32.08h-.688zm11.336.24c-.416 0-.832-.048-1.232-.144-.4-.096-.712-.2-.92-.32-.128-.072-.216-.152-.248-.224a.56.56 0 0 1-.048-.224v-.408c0-.168.064-.248.184-.248.048 0 .096.008.144.024.048.016.12.048.2.08.272.12.568.216.888.28.328.064.648.096.976.096.52 0 .92-.088 1.2-.264a.86.86 0 0 0 .424-.76.777.777 0 0 0-.212-.556c-.144-.152-.416-.288-.808-.416l-1.16-.36c-.584-.184-1.016-.456-1.288-.816a1.953 1.953 0 0 1-.408-1.184c0-.344.072-.648.216-.912.144-.264.336-.496.576-.688.24-.192.512-.336.832-.432.32-.096.656-.144 1.008-.144.176 0 .36.008.536.032.184.024.352.056.512.096.152.04.296.088.432.136.136.048.24.096.312.144a.649.649 0 0 1 .216.208.506.506 0 0 1 .064.256v.376c0 .168-.064.256-.184.256a.83.83 0 0 1-.3-.096 3.807 3.807 0 0 0-1.596-.328c-.472 0-.84.072-1.096.224-.256.152-.384.384-.384.704 0 .216.08.4.232.552.152.152.44.304.856.44l1.136.36c.576.184.992.44 1.24.768.248.328.368.704.368 1.12 0 .352-.072.672-.208.952-.144.28-.336.52-.592.72-.256.2-.56.344-.912.448-.368.112-.76.168-1.184.168z"/><path fill="#FF9900" d="M20.16 17.196c-2.464 1.8-6.032 2.752-9.112 2.752-4.312 0-8.2-1.6-11.136-4.248-.232-.208-.024-.496.256-.336 3.168 1.848 7.088 2.952 11.128 2.952 2.728 0 5.728-.568 8.488-1.744.416-.176.768.272.376.624z"/><path fill="#FF9900" d="M21.12 16.096c-.312-.4-2.072-.192-2.864-.096-.24.032-.28-.184-.064-.344 1.4-.984 3.704-.704 3.968-.368.264.336-.072 2.64-1.384 3.744-.2.168-.392.08-.304-.144.296-.736.952-2.392.648-2.792z"/></svg>
            <span style="font-weight:600;font-size:13px;color:var(--color-text-primary);">AWS CodeCommit</span>
          </div>
          <div onclick="selectConnProvider('github')" class="modal-provider-option">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            <span style="font-weight:600;font-size:13px;color:var(--color-text-primary);">GitHub</span>
          </div>
        </div>
      </div>

      <div id="conn-oauth-warning" style="display:none;padding:12px;background:rgba(245,158,11,0.1);border:1px solid var(--color-warning);border-radius:10px;margin-bottom:16px;font-size:12px;color:var(--color-text-primary);">
        GitHub OAuth connection required. Please authorize your GitHub account in <a href="/settings/integrations" style="color:#6366f1;font-weight:700;">Settings &gt; Integrations</a>.
      </div>

      <div id="conn-modal-msg" style="display:none;" class="msg-box error"></div>

      <!-- Tab Content: Connect Existing -->
      <div id="conn-tab-existing">
        <div style="border:1.5px dashed var(--color-border);border-radius:16px;padding:20px;background:var(--color-bg);margin-bottom:20px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <span style="font-size:11px;font-weight:800;letter-spacing:0.6px;color:var(--color-text-tertiary);text-transform:uppercase;">
              AVAILABLE REPOSITORIES
            </span>
            <button type="button" onclick="fetchAvailableRepos()" style="background:none;border:none;color:#6366f1;font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:4px;">
              <i data-lucide="refresh-cw" id="btn-refresh-avail-icon" style="width:13px;height:13px;"></i> Refresh
            </button>
          </div>

          <label style="display:block;font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">
            Select Repository
          </label>
          <select id="conn-select-repo" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-primary);font-size:13px;outline:none;"></select>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:20px;">
          <button type="button" onclick="closeConnectModal()" class="btn-secondary" style="padding:10px 20px;border-radius:10px;font-size:13px;font-weight:600;">
            Cancel
          </button>
          <button onclick="handleConnectExistingSubmit()" id="btn-submit-existing" style="padding:10px 22px;border-radius:10px;border:none;background:#6366f1;color:white;font-weight:700;font-size:13px;cursor:pointer;box-shadow:0 4px 14px rgba(99,102,241,0.35);">
            Connect Repository
          </button>
        </div>
      </div>

      <!-- Tab Content: Create New -->
      <div id="conn-tab-create" style="display:none;">
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">
            Repository Name
          </label>
          <input type="text" id="conn-new-name" placeholder="e.g. uat-benevolate-service" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:13px;outline:none;" />
        </div>
        <div style="margin-bottom:20px;">
          <label style="display:block;font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">
            Description (Optional)
          </label>
          <input type="text" id="conn-new-desc" placeholder="Production deployment repository" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:13px;outline:none;" />
        </div>

        <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:20px;">
          <button type="button" onclick="closeConnectModal()" class="btn-secondary" style="padding:10px 20px;border-radius:10px;font-size:13px;font-weight:600;">
            Cancel
          </button>
          <button onclick="handleCreateNewSubmit()" id="btn-submit-create" style="padding:10px 22px;border-radius:10px;border:none;background:#6366f1;color:white;font-weight:700;font-size:13px;cursor:pointer;box-shadow:0 4px 14px rgba(99,102,241,0.35);">
            Create &amp; Connect Repository
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
