<div class="branches-container">
  <!-- Header -->
  <div class="branches-header">
    <div>
      <h1 style="font-size:22px;font-weight:700;color:var(--color-text-primary);margin-bottom:2px;">Branches &amp; Commits</h1>
      <p style="font-size:13px;color:var(--color-text-secondary);">
        Select a repository to manage branches and view commit history.
      </p>
    </div>

    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
      <!-- Repository selector dropdown -->
      <div style="position:relative;" id="repo-selector-wrapper">
        <button onclick="toggleRepoDropdown()" id="btn-repo-selector" class="repo-selector-btn">
          <span id="repo-selector-icon">
            <i data-lucide="folder" style="width:14px;height:14px;color:var(--color-text-tertiary);"></i>
          </span>
          <span id="repo-selector-text" style="font-weight:600;font-size:13px;color:var(--color-text-primary);">
            Select Repository
          </span>
          <i data-lucide="chevron-down" id="repo-selector-arrow" style="width:14px;height:14px;color:var(--color-text-tertiary);margin-left:auto;transition:transform 0.15s ease;"></i>
        </button>

        <div id="repo-dropdown-menu" class="repo-dropdown-list" style="display:none;"></div>
      </div>

      <% if (user.userType === 'devops' || user.userType === 'admin' || user.userType === 'super_admin') { %>
        <button onclick="toggleCliPanel()" id="btn-toggle-cli" class="btn-cli-header">
          <i data-lucide="terminal" style="width:14px;height:14px;"></i> Git CLI Terminal
        </button>

        <button onclick="openCreateBranchModal()" id="btn-open-create-branch" disabled class="btn-create-branch-header">
          <i data-lucide="plus" style="width:16px;height:16px;"></i> Create Branch
        </button>
      <% } %>
    </div>
  </div>

  <!-- ── SERVER GIT CLI RUNNER PANEL ── -->
  <div id="cli-panel" class="cli-panel-box" style="display:none;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:14px;font-weight:600;">
      <i data-lucide="terminal" style="width:16px;height:16px;color:#6366f1;"></i> Server Git CLI Runner
    </div>
    <form onsubmit="handleExecCli(event)" style="display:flex;gap:10px;margin-bottom:12px;">
      <input
        type="text" id="cli-cmd-input" value="git status" placeholder="e.g. git log -n 5 --oneline"
        style="flex:1;padding:8px 12px;background:#161b22;border:1px solid #30363d;border-radius:8px;color:#e6edf3;font-family:monospace;font-size:13px;outline:none;"
      />
      <button type="submit" id="btn-run-cli" style="padding:8px 16px;background:#6366f1;color:white;border:none;border-radius:8px;font-weight:600;cursor:pointer;font-size:13px;">
        Run
      </button>
    </form>
    <pre id="cli-output-pre" style="display:none;background:#161b22;padding:14px;border-radius:8px;font-family:monospace;font-size:12px;overflow-x:auto;color:#7ee787;margin:0;border:1px solid #30363d;"></pre>
  </div>

  <!-- ── NO REPO CONNECTED STATE ── -->
  <div id="no-repo-state" style="display:none;background:var(--color-surface);border:1px dashed var(--color-border);border-radius:var(--radius-xl);padding:56px;text-align:center;">
    <i data-lucide="folder" style="width:40px;height:40px;color:var(--color-text-tertiary);margin-bottom:14px;"></i>
    <h3 id="no-repo-title" style="font-size:16px;font-weight:700;margin-bottom:6px;color:var(--color-text-primary);">Select a Repository</h3>
    <p id="no-repo-desc" style="font-size:14px;color:var(--color-text-secondary);max-width:400px;margin:0 auto;">
      Use the repository dropdown above to select a repository and view its branches.
    </p>
  </div>

  <!-- ── MAIN CONTENT GRID (BRANCHES + COMMITS) ── -->
  <div id="branches-main-grid" style="display:grid;grid-template-columns:280px 1fr;gap:20px;">
    
    <!-- LEFT PANEL: BRANCHES -->
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-xl);padding:18px;display:flex;flex-direction:column;min-height:300px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <h2 style="font-size:12px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:0.08em;margin:0;">
          BRANCHES <span id="branch-count-badge"></span>
        </h2>
        <button onclick="fetchBranches()" title="Refresh branches" style="background:none;border:none;cursor:pointer;color:var(--color-text-tertiary);display:flex;align-items:center;">
          <i data-lucide="refresh-cw" id="btn-refresh-branches-icon" style="width:13px;height:13px;"></i>
        </button>
      </div>

      <!-- Fetching branches... Loading State -->
      <div id="branches-loading" style="display:none;align-items:center;gap:8px;color:var(--color-text-tertiary);font-size:13px;padding:16px 0;">
        <i data-lucide="loader-2" class="animate-spin" style="width:14px;height:14px;color:var(--color-text-tertiary);"></i>
        <span>Fetching branches…</span>
      </div>

      <!-- GitHub Auth Expired Warning Box (Matches Screenshot 1) -->
      <div id="branches-auth-expired" style="display:none;padding:16px;background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.25);border-radius:12px;margin-top:4px;">
        <div style="font-size:13px;font-weight:700;color:#d97706;margin-bottom:6px;display:flex;align-items:center;gap:6px;">
          <i data-lucide="alert-triangle" style="width:16px;height:16px;color:#d97706;"></i> GitHub Auth Expired
        </div>
        <div style="font-size:12px;color:var(--color-text-secondary);line-height:1.5;margin-bottom:12px;">
          Your stored GitHub token was revoked or expired. Save a fresh PAT to restore access.
        </div>
        <a href="/settings" style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:#6366f1;text-decoration:none;padding:6px 12px;background:rgba(99,102,241,0.08);border-radius:8px;border:1px solid rgba(99,102,241,0.2);">
          Go to Settings &rarr; Git Credentials
        </a>
      </div>

      <!-- General Error Box -->
      <div id="branches-error" style="display:none;padding:14px 0;font-size:12px;color:var(--color-danger);align-items:flex-start;gap:6px;">
        <i data-lucide="alert-triangle" style="width:13px;height:13px;flex-shrink:0;margin-top:1px;"></i>
        <span id="branches-error-text"></span>
      </div>

      <!-- Branch Item Buttons Container -->
      <div id="branch-list-container" style="display:none;flex-direction:column;gap:3px;max-height:520px;overflow-y:auto;padding-right:2px;"></div>
    </div>

    <!-- RIGHT PANEL: COMMITS TIMELINE -->
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-xl);padding:22px;overflow:hidden;min-height:300px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
        <h2 style="font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px;margin:0;color:var(--color-text-primary);">
          <i data-lucide="git-commit" style="width:18px;height:18px;color:#6366f1;"></i>
          Commits on <span id="commit-branch-title" style="font-family:monospace;color:#6366f1;font-size:14px;">...</span>
          <span id="commit-provider-badge"></span>
        </h2>
        <button onclick="fetchCommits()" style="background:none;border:none;color:var(--color-text-tertiary);cursor:pointer;display:flex;align-items:center;gap:4px;font-size:13px;">
          <i data-lucide="refresh-cw" id="btn-refresh-commits-icon" style="width:14px;height:14px;"></i> Refresh
        </button>
      </div>

      <!-- Loading Commits skeleton -->
      <div id="commits-loading" style="display:none;flex-direction:column;gap:12px;">
        <div style="padding:14px;border-radius:10px;border:1px solid var(--color-border);background:var(--color-bg);opacity:0.6;">
          <div style="height:14px;width:60%;background:var(--color-border);border-radius:4px;margin-bottom:8px;"></div>
          <div style="height:11px;width:40%;background:var(--color-border);border-radius:4px;"></div>
        </div>
      </div>

      <!-- Empty / No Commits Found State (Matches Screenshot 1 & 2) -->
      <div id="commits-empty-state" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:64px 0;text-align:center;color:var(--color-text-tertiary);">
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;opacity:0.4;">
          <span style="width:12px;height:1px;background:var(--color-text-tertiary);"></span>
          <i data-lucide="git-commit" style="width:18px;height:18px;"></i>
          <span style="width:12px;height:1px;background:var(--color-text-tertiary);"></span>
        </div>
        <div id="commits-empty-text" style="font-size:14px;color:var(--color-text-tertiary);">
          No commits found for branch
        </div>
      </div>

      <!-- Commits List Container -->
      <div id="commits-list-container" style="display:none;flex-direction:column;gap:10px;max-height:520px;overflow-y:auto;padding-right:2px;"></div>
    </div>

  </div>

  <!-- ── CREATE BRANCH MODAL ── -->
  <div id="modal-create-branch" class="setup-modal-overlay" style="display:none;">
    <div class="setup-modal-box" style="max-width:440px;">
      <button onclick="closeCreateBranchModal()" style="position:absolute;top:20px;right:20px;background:none;border:none;color:var(--color-text-tertiary);cursor:pointer;padding:4px;">
        <i data-lucide="x" style="width:20px;height:20px;"></i>
      </button>

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="git-branch" style="width:18px;height:18px;color:white;"></i>
        </div>
        <div>
          <h3 style="font-size:16px;font-weight:700;margin:0;color:var(--color-text-primary);">Create New Branch</h3>
          <div id="create-modal-subtext" style="font-size:12px;color:var(--color-text-tertiary);margin-top:2px;">
            amruthkumartj/deploy-watch-new · GitHub
          </div>
        </div>
      </div>

      <form onsubmit="handleCreateBranchSubmit(event)">
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;font-weight:600;margin-bottom:6px;color:var(--color-text-secondary);">Branch Name</label>
          <input
            type="text" id="create-branch-name-input" placeholder="feature/my-new-feature" required
            style="width:100%;padding:9px 12px;border-radius:9px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:13px;outline:none;"
          />
        </div>
        <div style="margin-bottom:20px;">
          <label style="display:block;font-size:12px;font-weight:600;margin-bottom:6px;color:var(--color-text-secondary);">Base Branch</label>
          <select id="create-base-branch-select" style="width:100%;padding:9px 12px;border-radius:9px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:13px;outline:none;"></select>
        </div>

        <div id="create-branch-error" style="display:none;" class="msg-box error"></div>

        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;">
          <button type="button" onclick="closeCreateBranchModal()" class="btn-secondary" style="padding:9px 16px;border-radius:9px;font-size:13px;font-weight:600;">
            Cancel
          </button>
          <button type="submit" id="btn-submit-create-branch" style="padding:9px 18px;background:#6366f1;color:white;border:none;border-radius:9px;font-weight:700;cursor:pointer;font-size:13px;display:flex;align-items:center;gap:6px;box-shadow:0 4px 14px rgba(99,102,241,0.35);">
            <i data-lucide="plus" style="width:14px;height:14px;"></i> Create Branch
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
