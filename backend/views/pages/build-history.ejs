<div class="builds-container" style="max-width:1080px;margin:0 auto;padding-bottom:60px;">
  <% if (user.userType !== 'devops' && user.userType !== 'admin' && user.userType !== 'super_admin') { %>
    <div style="padding:60px;text-align:center;color:var(--color-text-tertiary);">
      <i data-lucide="shield-check" style="width:48px;height:48px;margin-bottom:12px;opacity:0.5;"></i>
      <h3 style="font-size:18px;color:var(--color-text-primary);margin-bottom:8px;font-weight:700;">Access Restricted</h3>
      <p style="font-size:14px;color:var(--color-text-secondary);max-width:440px;margin:0 auto;">You do not have permission to access this page. Please contact your organization administrator if you believe this is an error.</p>
    </div>
  <% } else { %>
    <!-- Header Banner -->
    <div class="page-header">
      <div>
        <div class="page-header-meta">
          <span class="page-service-badge indigo">
            <i data-lucide="terminal" style="width:12px;height:12px;"></i> AWS CODEBUILD LOG CENTER
          </span>
          <span class="page-header-context">
            <i data-lucide="chevron-right" style="width:12px;height:12px;"></i>
            <span id="builds-project-name" style="font-weight:600;color:var(--color-text-secondary);"></span>
          </span>
        </div>
        <h1 class="page-title">CodeBuild Execution History</h1>
        <p class="page-subtitle">Log of all past AWS CodeBuild jobs, execution durations, build status, and live CloudWatch logs.</p>
      </div>

      <div class="page-header-actions">
        <button onclick="fetchBuilds()" id="btn-refresh-builds" class="btn-secondary">
          <i data-lucide="refresh-cw" id="btn-refresh-builds-icon" style="width:14px;height:14px;"></i> Refresh History
        </button>
        <button onclick="handleTriggerBuild()" id="btn-trigger-build" class="btn-primary">
          <i data-lucide="play" style="width:14px;height:14px;"></i> Trigger New Build
        </button>
      </div>
    </div>

    <!-- Metrics Summary Bar -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:16px;margin-bottom:28px;">
      <div class="metrics-card">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--color-text-tertiary);">
          CodeBuild Project
        </div>
        <div id="metric-build-project-name" style="font-size:16px;font-weight:800;color:var(--color-text-primary);margin-top:4px;">
          --
        </div>
      </div>

      <div class="metrics-card">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--color-text-tertiary);">
          Total Executions
        </div>
        <div id="metric-build-total" style="font-size:20px;font-weight:800;color:var(--color-text-primary);margin-top:4px;">
          0
        </div>
      </div>

      <div class="metrics-card">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--color-text-tertiary);">
          Success Rate
        </div>
        <div id="metric-build-rate" style="font-size:20px;font-weight:800;color:#10b981;margin-top:4px;">
          100%
        </div>
      </div>
    </div>

    <!-- Main Execution History List -->
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;padding:24px;box-shadow:0 4px 20px rgba(0,0,0,0.04);">
      <h2 style="font-size:16px;font-weight:700;color:var(--color-text-primary);margin-bottom:16px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="clock" style="width:18px;height:18px;color:#6366f1;"></i>
        AWS CodeBuild Executions <span id="builds-count-tag" style="font-size:14px;font-weight:600;color:var(--color-text-tertiary);">(0)</span>
      </h2>

      <!-- Loading State -->
      <div id="builds-loading" style="display:flex;align-items:center;justify-content:center;gap:10px;padding:40px;color:var(--color-text-tertiary);font-size:13px;">
        <i data-lucide="loader-2" class="animate-spin" style="width:20px;height:20px;color:#6366f1;flex-shrink:0;"></i>
        <span>Loading CodeBuild executions from AWS...</span>
      </div>

      <!-- Empty State -->
      <div id="builds-empty" style="display:none;padding:40px;text-align:center;color:var(--color-text-tertiary);font-size:13px;">
        No CodeBuild execution records available for this project.
      </div>

      <!-- Builds List Container -->
      <div id="builds-list-container" style="display:none;flex-direction:column;gap:12px;"></div>
    </div>

    <!-- ── CLOUDWATCH LOG MODAL DIALOG ── -->
    <div id="modal-build-logs" class="setup-modal-overlay" style="display:none;">
      <div style="background:#090d16;border:1px solid #1e293b;border-radius:16px;width:100%;max-width:900px;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,0.5);overflow:hidden;">
        <!-- Modal Header -->
        <div style="padding:16px 20px;background:#0f172a;border-bottom:1px solid #1e293b;display:flex;justify-content:space-between;align-items:center;">
          <div style="display:flex;align-items:center;gap:10px;">
            <i data-lucide="terminal" style="width:18px;height:18px;color:#60a5fa;"></i>
            <div>
              <div id="log-modal-title" style="font-size:14px;font-weight:800;color:white;">CloudWatch Logs</div>
              <div id="log-modal-sub" style="font-size:11px;color:#94a3b8;"></div>
            </div>
          </div>
          <button onclick="closeLogModal()" style="background:none;border:none;color:#94a3b8;cursor:pointer;padding:4px;">
            <i data-lucide="x" style="width:20px;height:20px;"></i>
          </button>
        </div>

        <!-- Terminal Console Body -->
        <div id="log-terminal-body" style="flex:1;padding:20px;overflow-y:auto;font-family:Menlo, Monaco, Consolas, monospace;font-size:12px;line-height:1.6;color:#38bdf8;white-space:pre-wrap;word-break:break-all;"></div>

        <!-- Modal Footer -->
        <div style="padding:12px 20px;background:#0f172a;border-top:1px solid #1e293b;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#94a3b8;">
          <span>Log Group: <code id="log-modal-group" style="color:#e2e8f0;">/aws/codebuild</code></span>
          <button onclick="closeLogModal()" style="padding:6px 16px;border-radius:6px;border:none;background:#3b82f6;color:white;font-weight:700;font-size:12px;cursor:pointer;">Close Logs</button>
        </div>
      </div>
    </div>
  <% } %>
</div>
