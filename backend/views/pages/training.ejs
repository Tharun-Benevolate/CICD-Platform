<style>
  /* Premium UI Styles for Adoption Dashboard */
  .adoption-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 40px;
    color: var(--color-text-primary);
  }
  .header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .header-title h1 {
    font-size: 24px;
    font-weight: 800;
    margin: 0 0 8px 0;
    background: linear-gradient(90deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .header-title p {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Stats Grid */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .summary-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .summary-card .value {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }
  .summary-card .label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-secondary);
  }

  /* User List */
  .user-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .user-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .user-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    border-color: var(--color-primary);
  }
  
  .user-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .user-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: var(--color-text-primary);
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .user-details h3 {
    margin: 0 0 4px 0;
    font-size: 16px;
    font-weight: 600;
  }
  .user-details p {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* Progress Bar */
  .progress-section {
    width: 200px;
    text-align: right;
  }
  .progress-text {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .progress-bar-bg {
    height: 8px;
    background: var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #34d399);
    border-radius: 4px;
    transition: width 0.5s ease-out;
  }
  
  /* Tasks Checklist */
  .tasks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 12px;
    background: var(--color-bg-tertiary);
    padding: 16px;
    border-radius: 12px;
  }
  .task-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 12px;
    border-radius: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: all 0.2s;
  }
  .task-item.completed {
    background: rgba(16, 185, 129, 0.05);
    border-color: rgba(16, 185, 129, 0.3);
  }
  .task-item.pending {
    background: rgba(239, 68, 68, 0.05);
    border-color: rgba(239, 68, 68, 0.2);
  }
  .task-icon {
    font-size: 20px;
  }
  .task-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .completed .task-label {
    color: #10b981;
  }

  /* Skeleton Loading State */
  .skeleton {
    background: linear-gradient(90deg, var(--color-border) 25%, var(--color-bg-secondary) 50%, var(--color-border) 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
    border-radius: 4px;
  }
  @keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<div class="adoption-container">
  <div class="header-section">
    <div class="header-title">
      <h1>GitHub Adoption Tracker</h1>
      <p>Monitor team progress across required Git onboarding tasks.</p>
      <div id="trackingSinceBadge" style="display:none;margin-top:8px;font-size:12px;color:#f59e0b;display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:6px;">
        <i data-lucide="calendar" style="width:12px;height:12px;"></i>
        <span id="trackingSinceLabel">Tracking since: —</span>
      </div>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <button class="btn" id="resetBtn" onclick="resetTracking()" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#ef4444;">
        <i data-lucide="rotate-ccw" style="width:14px;height:14px;margin-right:6px;"></i>
        Reset Fresh Start
      </button>
      <button class="btn btn-primary" onclick="loadAdoptionStats()" id="refreshBtn">
        <i data-lucide="refresh-cw" style="width:14px;height:14px;margin-right:6px;"></i>
        Refresh Data
      </button>
    </div>
  </div>

  <div class="summary-grid" id="summaryGrid">
    <div class="summary-card">
      <div class="value skeleton" style="height:32px;width:60px;margin:0 auto 8px;"></div>
      <div class="label">Total Team</div>
    </div>
    <div class="summary-card">
      <div class="value skeleton" style="height:32px;width:60px;margin:0 auto 8px;"></div>
      <div class="label">Fully Adopted</div>
    </div>
    <div class="summary-card">
      <div class="value skeleton" style="height:32px;width:60px;margin:0 auto 8px;"></div>
      <div class="label">Average Progress</div>
    </div>
  </div>

  <div class="user-list" id="userList">
    <!-- Populated by JS -->
    <div class="user-card" style="opacity:0.6;">
      <div class="user-card-header">
        <div class="user-info">
          <div class="avatar skeleton"></div>
          <div class="user-details">
            <div class="skeleton" style="height:16px;width:120px;margin-bottom:8px;"></div>
            <div class="skeleton" style="height:12px;width:80px;"></div>
          </div>
        </div>
      </div>
      <div class="tasks-grid">
        <div class="task-item"><div class="skeleton" style="height:24px;width:24px;border-radius:50%"></div></div>
        <div class="task-item"><div class="skeleton" style="height:24px;width:24px;border-radius:50%"></div></div>
        <div class="task-item"><div class="skeleton" style="height:24px;width:24px;border-radius:50%"></div></div>
        <div class="task-item"><div class="skeleton" style="height:24px;width:24px;border-radius:50%"></div></div>
        <div class="task-item"><div class="skeleton" style="height:24px;width:24px;border-radius:50%"></div></div>
      </div>
    </div>
  </div>
</div>
