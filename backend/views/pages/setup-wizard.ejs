<div class="setup-container">
  <% if (user.userType !== 'devops' && user.userType !== 'admin' && user.userType !== 'super_admin') { %>
    <!-- Access Restricted View for Non-DevOps Roles -->
    <div style="padding:40px;text-align:center;color:var(--color-text-tertiary);">
      <i data-lucide="shield-alert" style="width:48px;height:48px;color:var(--color-warning);margin-bottom:12px;"></i>
      <h2 style="font-size:18px;font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">
        Access Restricted
      </h2>
      <p style="font-size:14px;color:var(--color-text-secondary);max-width:440px;margin:0 auto;">
        You do not have permission to access this page. Please contact your organization administrator if you believe this is an error.
      </p>
    </div>
  <% } else { %>
    <!-- DevOps Setup Wizard View -->

    <!-- Header -->
    <div style="margin-bottom:28px;">
      <h1 style="font-size:24px;font-weight:800;color:var(--color-text-primary);margin-bottom:6px;display:flex;align-items:center;gap:10px;">
        <i data-lucide="sparkles" style="width:24px;height:24px;color:var(--color-primary);"></i>
        Setup Wizard — <span id="setup-project-title">Platform</span>
      </h1>
      <p style="font-size:14px;color:var(--color-text-secondary);">
        One shared foundation run plus two per-project Terraform runs build everything automatically. No console visits, no ARN pasting.
      </p>
    </div>

    <!-- Overview Cards Row -->
    <div class="setup-cards-row">
      <div class="setup-card">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--color-primary-light);color:var(--color-primary);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;">0</div>
          <span style="font-weight:700;font-size:13px;color:var(--color-text-primary);">Shared Foundation</span>
        </div>
        <span style="font-size:11px;color:var(--color-text-tertiary);">
          VPC &bull; Subnets &bull; NAT &bull; Shared ALB
        </span>
      </div>

      <div class="setup-card">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--color-primary-light);color:var(--color-primary);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;">1</div>
          <span style="font-weight:700;font-size:13px;color:var(--color-text-primary);">Initial Infra</span>
        </div>
        <span style="font-size:11px;color:var(--color-text-tertiary);">
          IAM &bull; S3 &bull; CodeBuild
        </span>
      </div>

      <div class="setup-card">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--color-primary-light);color:var(--color-primary);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;">2</div>
          <span style="font-weight:700;font-size:13px;color:var(--color-text-primary);">Deployment Infra</span>
        </div>
        <span style="font-size:11px;color:var(--color-text-tertiary);">
          ECR &bull; Non-Prod ECS Cluster &bull; Prod ECS Cluster &bull; Pipeline
        </span>
      </div>
    </div>

    <!-- Error Alert Message Box -->
    <div id="setup-error-msg" style="display:none;padding:12px 16px;background:var(--color-danger-light);color:var(--color-danger);border-radius:12px;font-size:13px;font-weight:600;margin-bottom:20px;"></div>

    <!-- ── LIVE TERRAFORM EXECUTION TERMINAL CONSOLE ── -->
    <div id="terminal-box" class="terminal-box" style="display:none;">
      <div class="terminal-header">
        <div style="display:flex;align-items:center;gap:8px;color:#f8fafc;font-weight:700;font-size:14px;">
          <i data-lucide="terminal" style="width:16px;height:16px;color:#38bdf8;"></i>
          <span>Terraform Execution Console — <span id="terminal-type-label">LIVE</span></span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
          <span id="terminal-status-badge" style="font-size:12px;background:rgba(56,189,248,0.15);color:#38bdf8;padding:3px 10px;border-radius:20px;font-weight:700;display:flex;align-items:center;gap:6px;">
            <i data-lucide="loader-2" class="animate-spin" style="width:12px;height:12px;"></i> RUNNING
          </span>
          <button type="button" onclick="closeTerminalConsole()" title="Close console" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;border-radius:6px;width:24px;height:24px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:12px;">
            ✕
          </button>
        </div>
      </div>
      <pre id="terminal-logs-pre" class="terminal-pre"></pre>
    </div>

    <!-- SECTION 0: SHARED FOUNDATION INFRASTRUCTURE -->
    <div class="setup-section-box">
      <h2 style="font-size:17px;font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">
        0. Shared Foundation Infrastructure (shared-foundation-terraform)
      </h2>
      <p style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;margin-bottom:16px;">
        One-time platform stack provisioning: VPC &bull; Public/Private Subnets &bull; NAT Gateway &bull; Shared ALB &bull; Shared Security Groups.
      </p>

      <div id="foundation-status-container" style="margin-bottom:16px;">
        <div style="padding:8px 12px;background:var(--color-bg);border:1px solid var(--color-border);color:var(--color-text-tertiary);border-radius:8px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:6px;">
          <i data-lucide="loader-2" class="animate-spin" style="width:14px;height:14px;color:var(--color-primary);"></i> Checking Shared Foundation status...
        </div>
      </div>

      <div style="display:flex;gap:12px;flex-wrap:wrap;" id="foundation-actions-row"></div>
    </div>

    <!-- SECTION 1: INITIAL INFRASTRUCTURE -->
    <div class="setup-section-box">
      <h2 style="font-size:17px;font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">
        1. Initial Infrastructure
      </h2>
      <p style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;margin-bottom:14px;">
        Creates: S3 bucket &bull; GitHub CodeStar connection &bull; 3 IAM roles (Build, Pipeline, ECS Execution) &bull; CodeBuild project.
      </p>

      <div style="font-size:12px;color:var(--color-text-tertiary);margin-bottom:20px;">
        Repository is automatically sourced from your project configuration. Connected to repo <strong id="initial-repo-name" style="color:var(--color-text-primary);">...</strong>.
      </div>

      <div id="initial-status-badge" style="display:none;" class="badge-status-green">
        <i data-lucide="check-circle-2" style="width:16px;height:16px;"></i> Initial Infrastructure Provisioned
      </div>

      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <button id="btn-run-initial" onclick="handleRunInitial()" class="btn-grad-primary">
          Create Initial Infrastructure
        </button>
        <button id="btn-destroy-initial" onclick="handlePromptDestroyInitial()" class="btn-outline-danger" style="display:none;">
          <i data-lucide="trash-2" style="width:14px;height:14px;"></i> Destroy Initial Infra
        </button>
      </div>
    </div>

    <!-- SECTION 2: DEPLOYMENT INFRASTRUCTURE -->
    <div class="setup-section-box">
      <h2 style="font-size:17px;font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">
        2. Deployment Infrastructure
      </h2>
      <p style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;margin-bottom:14px;">
        Creates: ECR repository &bull; <strong>Non-Prod ECS Cluster</strong> (Dev &amp; UAT Fargate services) &bull; <strong>Prod ECS Cluster</strong> (Prod Fargate service) &bull; ALB target groups (Dev, UAT, Prod Blue) &bull; Listener rules &bull; CloudWatch log groups &bull; Auto-scaling &bull; Route53 DNS &bull; 7-stage CodePipeline.
      </p>

      <div style="font-size:12px;color:var(--color-text-tertiary);margin-bottom:20px;">
        All inputs are automatically sourced from Step 1 outputs — just click the button.
      </div>

      <div id="deploy-status-badge" style="display:none;" class="badge-status-green">
        <i data-lucide="check-circle-2" style="width:16px;height:16px;"></i> Deployment Infrastructure Provisioned
      </div>

      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <button id="btn-run-deploy" onclick="handleRunDeployment()" class="btn-grad-primary">
          Create Deployment Infrastructure
        </button>
        <button id="btn-destroy-deploy" onclick="handlePromptDestroyDeployment()" class="btn-outline-danger" style="display:none;">
          <i data-lucide="trash-2" style="width:14px;height:14px;"></i> Destroy Deployment Infra
        </button>
      </div>
    </div>

    <!-- SECTION 3: SECRETS MANAGEMENT -->
    <div class="setup-section-box">
      <h2 style="font-size:17px;font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">
        3. Environment Secrets Management
      </h2>
      <p style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;margin-bottom:14px;">
        Store sensitive configuration (e.g. <code>DB_HOST</code>, <code>DB_PASSWORD</code>) directly in AWS Secrets Manager — <strong>one secret per environment</strong>. Each environment (Dev, UAT, Prod) gets its own secret with its own database credentials.
      </p>

      <div style="font-size:12px;color:var(--color-text-tertiary);margin-bottom:20px;">
        <i data-lucide="lock" style="width:12px;height:12px;display:inline-block;vertical-align:text-bottom;"></i> Values are stored in AWS Secrets Manager only — never in the platform database. Each environment can have different DB_HOST, DB_NAME, etc. UAT can inherit from Dev, Prod can inherit from Dev or UAT.
      </div>

      <!-- ── Environment Tabs ── -->
      <div id="secrets-env-tabs" style="display:flex;gap:0;margin-bottom:0;border-bottom:2px solid var(--color-border);">
        <button class="secrets-tab active" data-env="dev" onclick="switchSecretsTab('dev')" style="padding:10px 20px;font-size:13px;font-weight:600;border:none;cursor:pointer;background:transparent;color:var(--color-text-tertiary);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all 0.2s;">
          Dev
        </button>
        <button class="secrets-tab" data-env="uat" onclick="switchSecretsTab('uat')" style="padding:10px 20px;font-size:13px;font-weight:600;border:none;cursor:pointer;background:transparent;color:var(--color-text-tertiary);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all 0.2s;">
          UAT
        </button>
        <button class="secrets-tab" data-env="prod" onclick="switchSecretsTab('prod')" style="padding:10px 20px;font-size:13px;font-weight:600;border:none;cursor:pointer;background:transparent;color:var(--color-text-tertiary);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all 0.2s;">
          Prod
        </button>
      </div>

      <!-- ── Tab Content (one per env, shown/hidden by JS) ── -->
      <div id="secrets-tab-dev" class="secrets-tab-content" style="padding-top:18px;">
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">
            AWS Secrets Manager secret name
          </label>
          <input type="text" id="secret-name-dev" class="secret-name-input" data-env="dev" placeholder="e.g. my-project/dev-secrets" autocomplete="off" data-lpignore="true"
                 style="width:100%;max-width:420px;padding:8px 10px;border-radius:6px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);outline:none;font-family:monospace;font-size:13px;" />
          <div id="secret-name-hint-dev" class="secret-name-hint" style="font-size:11px;color:var(--color-text-tertiary);margin-top:6px;"></div>
        </div>
        <div id="secrets-table-dev" class="secrets-table-container" style="margin-bottom:16px;"></div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <button onclick="handleAddSecretRow('dev')" class="btn-secondary" style="font-size:13px;padding:8px 14px;">
            <i data-lucide="plus" style="width:14px;height:14px;"></i> Add Secret Key
          </button>
          <button onclick="handleDeleteEntireSecret('dev')" class="btn-danger-outline" style="font-size:12px;padding:6px 12px;color:var(--color-danger);border:1px solid var(--color-danger);border-radius:6px;background:transparent;cursor:pointer;">
            <i data-lucide="trash-2" style="width:12px;height:12px;"></i> Delete Secret
          </button>
          <button onclick="handleSaveSecrets('dev')" class="btn-grad-primary" style="font-size:13px;padding:8px 16px;">
            Save Dev Secrets
          </button>
        </div>
        <div id="secrets-save-msg-dev" style="margin-top:12px;font-size:12px;display:none;"></div>
      </div>

      <div id="secrets-tab-uat" class="secrets-tab-content" style="padding-top:18px;display:none;">
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">
            AWS Secrets Manager secret name
          </label>
          <input type="text" id="secret-name-uat" class="secret-name-input" data-env="uat" placeholder="e.g. my-project/uat-secrets" autocomplete="off" data-lpignore="true"
                 style="width:100%;max-width:420px;padding:8px 10px;border-radius:6px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);outline:none;font-family:monospace;font-size:13px;" />
          <div id="secret-name-hint-uat" class="secret-name-hint" style="font-size:11px;color:var(--color-text-tertiary);margin-top:6px;"></div>
        </div>
        <!-- Inheritance controls -->
        <div style="margin-bottom:14px;padding:10px 14px;border-radius:8px;background:var(--color-bg-secondary);border:1px solid var(--color-border);">
          <label style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-right:12px;">Inherit from:</label>
          <button onclick="handleInheritSecrets('dev','uat')" class="btn-secondary" style="font-size:12px;padding:5px 12px;">
            Copy from Dev (pre-fill values)
          </button>
          <span style="font-size:11px;color:var(--color-text-tertiary);margin-left:8px;">Pre-fills values from Dev — edit what's different, then save.</span>
        </div>
        <div id="secrets-table-uat" class="secrets-table-container" style="margin-bottom:16px;"></div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <button onclick="handleAddSecretRow('uat')" class="btn-secondary" style="font-size:13px;padding:8px 14px;">
            <i data-lucide="plus" style="width:14px;height:14px;"></i> Add Secret Key
          </button>
          <button onclick="handleDeleteEntireSecret('uat')" class="btn-danger-outline" style="font-size:12px;padding:6px 12px;color:var(--color-danger);border:1px solid var(--color-danger);border-radius:6px;background:transparent;cursor:pointer;">
            <i data-lucide="trash-2" style="width:12px;height:12px;"></i> Delete Secret
          </button>
          <button onclick="handleSaveSecrets('uat')" class="btn-grad-primary" style="font-size:13px;padding:8px 16px;">
            Save UAT Secrets
          </button>
        </div>
        <div id="secrets-save-msg-uat" style="margin-top:12px;font-size:12px;display:none;"></div>
      </div>

      <div id="secrets-tab-prod" class="secrets-tab-content" style="padding-top:18px;display:none;">
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">
            AWS Secrets Manager secret name
          </label>
          <input type="text" id="secret-name-prod" class="secret-name-input" data-env="prod" placeholder="e.g. my-project/prod-secrets" autocomplete="off" data-lpignore="true"
                 style="width:100%;max-width:420px;padding:8px 10px;border-radius:6px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);outline:none;font-family:monospace;font-size:13px;" />
          <div id="secret-name-hint-prod" class="secret-name-hint" style="font-size:11px;color:var(--color-text-tertiary);margin-top:6px;"></div>
        </div>
        <!-- Inheritance controls -->
        <div style="margin-bottom:14px;padding:10px 14px;border-radius:8px;background:var(--color-bg-secondary);border:1px solid var(--color-border);">
          <label style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin-right:12px;">Inherit from:</label>
          <button onclick="handleInheritSecrets('dev','prod')" class="btn-secondary" style="font-size:12px;padding:5px 12px;margin-right:8px;">
            Copy from Dev
          </button>
          <button onclick="handleInheritSecrets('uat','prod')" class="btn-secondary" style="font-size:12px;padding:5px 12px;">
            Copy from UAT
          </button>
          <span style="font-size:11px;color:var(--color-text-tertiary);margin-left:8px;">Pre-fills values — edit what's different, then save.</span>
        </div>
        <div id="secrets-table-prod" class="secrets-table-container" style="margin-bottom:16px;"></div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <button onclick="handleAddSecretRow('prod')" class="btn-secondary" style="font-size:13px;padding:8px 14px;">
            <i data-lucide="plus" style="width:14px;height:14px;"></i> Add Secret Key
          </button>
          <button onclick="handleDeleteEntireSecret('prod')" class="btn-danger-outline" style="font-size:12px;padding:6px 12px;color:var(--color-danger);border:1px solid var(--color-danger);border-radius:6px;background:transparent;cursor:pointer;">
            <i data-lucide="trash-2" style="width:12px;height:12px;"></i> Delete Secret
          </button>
          <button onclick="handleSaveSecrets('prod')" class="btn-grad-primary" style="font-size:13px;padding:8px 16px;">
            Save Prod Secrets
          </button>
        </div>
        <div id="secrets-save-msg-prod" style="margin-top:12px;font-size:12px;display:none;"></div>
      </div>

      <!-- ── APPLY ACTIONS ── -->
      <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--color-border);">
        <div style="font-size:13px;font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">
          Apply Secret Changes to Running Containers
        </div>
        <p style="font-size:12px;color:var(--color-text-tertiary);margin-bottom:14px;line-height:1.6;">
          <strong style="color:var(--color-text-secondary);">Updated a value?</strong> Use <em>Restart ECS</em> — fast, zero-downtime (30s).<br>
          <strong style="color:var(--color-text-secondary);">Added a new key?</strong> Use <em>Re-apply Infra</em> to update the task definition (~3–4 min).
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <button id="btn-restart-ecs" onclick="handleRestartEcs()" class="btn-secondary" style="font-size:13px;padding:8px 16px;gap:6px;display:inline-flex;align-items:center;">
            <i data-lucide="rotate-ccw" style="width:14px;height:14px;"></i> Restart ECS Services
          </button>
          <button id="btn-reapply-deploy" onclick="handleReapplyDeployment()" class="btn-grad-blue" style="font-size:13px;padding:8px 16px;gap:6px;display:inline-flex;align-items:center;">
            <i data-lucide="refresh-cw" style="width:14px;height:14px;"></i> Re-apply Deployment Infra
          </button>
        </div>

        <!-- Inline status panel (restart or apply) -->
        <div id="secrets-action-status" style="display:none;margin-top:16px;border-radius:10px;border:1px solid var(--color-border);overflow:hidden;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--color-bg-secondary);border-bottom:1px solid var(--color-border);">
            <div style="display:flex;align-items:center;gap:8px;">
              <span id="secrets-action-label" style="font-size:12px;font-weight:700;color:var(--color-text-primary);letter-spacing:0.5px;">RESTART</span>
              <span id="secrets-action-badge" style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:rgba(56,189,248,0.15);color:#38bdf8;display:inline-flex;align-items:center;gap:4px;">
                <i data-lucide="loader-2" class="animate-spin" style="width:10px;height:10px;"></i> RUNNING
              </span>
            </div>
            <button onclick="document.getElementById('secrets-action-status').style.display='none'" style="background:transparent;border:none;cursor:pointer;color:var(--color-text-tertiary);padding:2px;">
              <i data-lucide="x" style="width:14px;height:14px;"></i>
            </button>
          </div>
          <div id="secrets-action-log" style="padding:12px 14px;font-family:monospace;font-size:12px;color:#cbd5e1;background:#0f172a;max-height:260px;overflow-y:auto;white-space:pre-wrap;"></div>
        </div>
      </div>
    </div>

    <!-- SECTION 4: DANGER ZONE — DESTROY ENTIRE PROJECT -->
    <div class="setup-danger-box">
      <h2 style="font-size:17px;font-weight:700;color:var(--color-danger);margin-bottom:6px;">
        4. Danger Zone: Destroy Entire Project
      </h2>
      <p style="font-size:13px;color:var(--color-text-secondary);margin-bottom:20px;">
        Deletes all infrastructure and settings saved for this project. This action is permanent.
      </p>

      <button onclick="handleOpenDestroyProjectModal()" class="btn-outline-danger">
        Destroy &amp; Delete Project
      </button>
    </div>

    <!-- ── CUSTOM CONFIRMATION MODAL OVERLAY ── -->
    <div id="custom-confirm-modal" class="setup-modal-overlay" style="display:none;">
      <div class="setup-modal-box">
        <h3 id="modal-title" style="font-size:18px;font-weight:700;color:var(--color-danger);margin-bottom:12px;display:flex;align-items:center;gap:8px;">
          <i data-lucide="shield-alert" style="width:22px;height:22px;color:var(--color-danger);"></i>
          <span id="modal-title-text">Confirm Action</span>
        </h3>
        <p id="modal-desc" style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:24px;white-space:pre-line;"></p>
        <div style="display:flex;justify-content:flex-end;gap:12px;">
          <button type="button" id="modal-btn-cancel" onclick="closeConfirmModal()" class="btn-secondary" style="padding:10px 18px;font-size:13px;">
            Cancel
          </button>
          <button type="button" id="modal-btn-action" onclick="executeConfirmModalAction()" class="btn-danger" style="padding:10px 20px;font-size:13px;">
            Confirm Action
          </button>
        </div>
      </div>
    </div>

    <!-- ── DESTROY PROJECT & REPOSITORIES MODAL ── -->
    <div id="destroy-project-modal" class="setup-modal-overlay" style="display:none;">
      <div class="setup-modal-box" style="max-width:520px;">
        <h2 style="font-size:20px;font-weight:800;color:var(--color-danger);margin-bottom:8px;">
          Destroy Project &amp; Repositories
        </h2>
        <p style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;margin-bottom:20px;">
          Are you absolutely sure you want to delete this project? Please choose repository cleanup action:
        </p>

        <!-- Provider Repository Deletion Checkbox Box -->
        <div style="background:rgba(239, 68, 68, 0.05);border:1px solid rgba(239, 68, 68, 0.25);border-radius:14px;padding:16px;margin-bottom:20px;">
          <label style="display:flex;gap:12px;cursor:pointer;align-items:flex-start;">
            <input type="checkbox" id="chk-delete-provider-repos" style="margin-top:3px;width:16px;height:16px;accent-color:var(--color-danger);" />
            <div>
              <div style="font-size:13px;font-weight:800;color:var(--color-danger);letter-spacing:0.2px;">
                DISCONNECT &amp; DELETE REPOSITORIES FROM PROVIDER (AWS/GITHUB)
              </div>
              <div style="font-size:12px;color:var(--color-text-secondary);margin-top:4px;line-height:1.4;">
                If checked, we will trigger API calls to delete the connected git repositories from the hosting provider side as well.
              </div>
            </div>
          </label>
        </div>

        <!-- Confirmation Name Input -->
        <div style="margin-bottom:24px;">
          <label style="display:block;font-size:11px;font-weight:800;letter-spacing:0.6px;color:var(--color-text-tertiary);text-transform:uppercase;margin-bottom:6px;">
            TO CONFIRM, TYPE THE PROJECT NAME: <strong id="destroy-target-project-name" style="color:var(--color-text-primary);">...</strong>
          </label>
          <input
            type="text"
            id="destroy-confirm-input"
            placeholder="Type project name here"
            oninput="validateDestroyConfirmInput()"
            style="width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:14px;outline:none;"
          />
        </div>

        <div id="destroy-project-error" style="display:none;" class="msg-box error"></div>

        <!-- Modal Actions -->
        <div style="display:flex;justify-content:flex-end;gap:12px;">
          <button type="button" onclick="closeDestroyProjectModal()" class="btn-secondary" style="padding:10px 20px;font-size:14px;">
            Cancel
          </button>
          <button type="button" id="btn-confirm-destroy-project" disabled onclick="executeDestroyProject()" class="btn-danger" style="padding:10px 22px;font-size:14px;opacity:0.4;cursor:not-allowed;">
            Completely Destroy Project
          </button>
        </div>
      </div>
    </div>

  <% } %>
</div>
