<div class="scaling-container" style="max-width:1080px;margin:0 auto;padding-bottom:60px;">
  <% if (user.userType !== 'devops' && user.userType !== 'admin' && user.userType !== 'super_admin') { %>
    <div style="padding:60px;text-align:center;color:var(--color-text-tertiary);">
      <i data-lucide="shield-check" style="width:48px;height:48px;margin-bottom:12px;opacity:0.5;"></i>
      <h3 style="font-size:18px;color:var(--color-text-primary);margin-bottom:8px;font-weight:700;">Access Restricted</h3>
      <p style="font-size:14px;color:var(--color-text-secondary);max-width:440px;margin:0 auto;">You do not have permission to access this page. Please contact your organization administrator if you believe this is an error.</p>
    </div>
  <% } else { %>
    <!-- Header Banner -->
    <div class="page-header">
      <div>
        <div class="page-header-meta">
          <span class="page-service-badge blue">
            <i data-lucide="zap" style="width:12px;height:12px;"></i> AWS ECS AUTO-SCALING ENGINE
          </span>
          <span class="page-header-context">
            <i data-lucide="chevron-right" style="width:12px;height:12px;"></i>
            <span id="scaling-project-name" style="font-weight:600;color:var(--color-text-secondary);"></span>
          </span>
        </div>
        <h1 class="page-title">ECS Task Auto-scaling &amp; Fleet Operations</h1>
        <p class="page-subtitle">Manage real-time ECS task counts, configure Target Tracking CPU policies, and inspect CloudWatch auto-scaling activity.</p>
      </div>

      <div class="page-header-actions">
        <button onclick="fetchAllData()" id="btn-refresh-scaling" class="btn-secondary">
          <i data-lucide="refresh-cw" id="btn-refresh-scale-icon" style="width:14px;height:14px;"></i> Refresh Fleet Status
        </button>
      </div>
    </div>

    <!-- Result Banner Notification -->
    <div id="scaling-result-banner" style="display:none;margin-bottom:20px;padding:16px;border-radius:12px;font-size:13px;font-weight:600;display:flex;align-items:center;gap:10px;"></div>

    <!-- SECTION 1: LIVE ECS FLEET TASK CONTROLLER -->
    <h2 style="font-size:16px;font-weight:700;color:var(--color-text-primary);margin-bottom:14px;display:flex;align-items:center;gap:8px;">
      <i data-lucide="server" style="width:18px;height:18px;color:#6366f1;"></i> Live AWS ECS Task Fleet Status
    </h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:20px;margin-bottom:32px;">
      <% ['dev', 'uat', 'prod'].forEach(function(env) { %>
        <div class="scaling-card" id="fleet-card-<%= env %>">
          <div>
            <!-- Environment Header -->
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
              <span style="padding:4px 10px;border-radius:6px;font-size:12px;font-weight:800;text-transform:uppercase;background:<%= env === 'prod' ? 'rgba(239,68,68,0.12)' : env === 'uat' ? 'rgba(245,158,11,0.12)' : 'rgba(59,130,246,0.12)' %>;color:<%= env === 'prod' ? '#ef4444' : env === 'uat' ? '#f59e0b' : '#3b82f6' %>;">
                <%= env %> FLEET
              </span>
              <span id="badge-status-<%= env %>" style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(100,116,139,0.15);color:#64748b;border:1px solid rgba(100,116,139,0.3);">
                SCALED TO 0
              </span>
            </div>

            <!-- Task Count Stats -->
            <div style="background:var(--color-bg);border:1px solid var(--color-border);border-radius:12px;padding:14px;margin-bottom:16px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;text-align:center;">
              <div>
                <div style="font-size:11px;color:var(--color-text-tertiary);text-transform:uppercase;font-weight:700;">Running</div>
                <div id="stat-running-<%= env %>" style="font-size:20px;font-weight:800;color:var(--color-text-primary);">0</div>
              </div>
              <div style="border-left:1px solid var(--color-border);border-right:1px solid var(--color-border);">
                <div style="font-size:11px;color:var(--color-text-tertiary);text-transform:uppercase;font-weight:700;">Desired</div>
                <div id="stat-desired-<%= env %>" style="font-size:20px;font-weight:800;color:var(--color-text-primary);">0</div>
              </div>
              <div>
                <div style="font-size:11px;color:var(--color-text-tertiary);text-transform:uppercase;font-weight:700;">Pending</div>
                <div id="stat-pending-<%= env %>" style="font-size:20px;font-weight:800;color:var(--color-text-secondary);">0</div>
              </div>
            </div>

            <!-- Container Image Tag -->
            <div id="image-tag-wrap-<%= env %>" style="display:none;font-size:11px;color:var(--color-text-tertiary);margin-bottom:16px;justify-content:space-between;align-items:center;">
              <span>Active Image:</span>
              <code id="image-tag-val-<%= env %>" onclick="copyImageUri('<%= env %>')" style="padding:2px 6px;background:var(--color-bg);border-radius:4px;color:#6366f1;font-weight:700;cursor:pointer;"></code>
            </div>
          </div>

          <!-- Direct Scaling Actions -->
          <div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
              <button onclick="handleDirectScale('<%= env %>', 0)" id="btn-scale-zero-<%= env %>" style="height:36px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);background:var(--color-bg);color:var(--color-text-tertiary);font-weight:700;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;">
                <i data-lucide="power" style="width:13px;height:13px;"></i> Scale to 0
              </button>
              <button onclick="handleDirectScaleUp('<%= env %>')" id="btn-scale-up-<%= env %>" style="height:36px;border-radius:8px;border:none;background:#6366f1;color:white;font-weight:700;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;">
                <i data-lucide="trending-up" style="width:13px;height:13px;"></i> + Scale Up (+1)
              </button>
            </div>

            <!-- Custom Desired Input -->
            <div style="display:flex;gap:6px;">
              <input type="number" min="0" max="20" id="custom-desired-<%= env %>" placeholder="Custom count..." style="flex:1;height:34px;padding:0 10px;border-radius:6px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:12px;outline:none;" />
              <button onclick="handleCustomScale('<%= env %>')" style="height:34px;padding:0 12px;border-radius:6px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-primary);font-weight:700;font-size:12px;cursor:pointer;">
                Set Count
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- SECTION 2: TARGET TRACKING AUTO-SCALING POLICY CONFIGURATOR -->
    <h2 style="font-size:16px;font-weight:700;color:var(--color-text-primary);margin-bottom:14px;display:flex;align-items:center;gap:8px;">
      <i data-lucide="sliders" style="width:18px;height:18px;color:#6366f1;"></i> AWS Target Tracking CPU Auto-Scaling Policies
    </h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:20px;margin-bottom:32px;">
      <% ['dev', 'uat', 'prod'].forEach(function(env) { %>
        <div class="scaling-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <span style="font-size:14px;font-weight:800;text-transform:uppercase;color:var(--color-text-primary);">
              <%= env %> Policy Rule
            </span>
            <span id="policy-badge-<%= env %>" style="font-size:11px;color:var(--color-text-tertiary);font-weight:700;">
              Default Preset
            </span>
          </div>

          <!-- Form Controls -->
          <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:18px;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;color:var(--color-text-tertiary);margin-bottom:4px;">Min Tasks</label>
                <input type="number" min="0" max="10" id="policy-min-<%= env %>" value="<%= env === 'prod' ? 2 : 1 %>" style="width:100%;height:36px;padding:0 10px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:13px;font-weight:700;outline:none;" />
              </div>
              <div>
                <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;color:var(--color-text-tertiary);margin-bottom:4px;">Max Tasks</label>
                <input type="number" min="1" max="50" id="policy-max-<%= env %>" value="<%= env === 'prod' ? 10 : 5 %>" style="width:100%;height:36px;padding:0 10px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text-primary);font-size:13px;font-weight:700;outline:none;" />
              </div>
            </div>

            <div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                <label style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--color-text-tertiary);">Target CPU Utilization (%)</label>
                <span id="policy-cpu-val-<%= env %>" style="font-size:13px;font-weight:800;color:#6366f1;">70%</span>
              </div>
              <input type="range" min="10" max="90" step="5" id="policy-cpu-slider-<%= env %>" value="70" oninput="updateCpuSliderVal('<%= env %>', this.value)" style="width:100%;cursor:pointer;accent-color:#6366f1;" />
              <div id="policy-cpu-desc-<%= env %>" style="font-size:11px;color:var(--color-text-tertiary);margin-top:2px;">
                AWS will scale out when avg CPU exceeds 70%.
              </div>
            </div>
          </div>

          <button onclick="handleSavePolicy('<%= env %>')" id="btn-save-policy-<%= env %>" style="width:100%;height:38px;border-radius:8px;background:rgba(99,102,241,0.15);color:#6366f1;font-weight:700;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid rgba(99,102,241,0.3);">
            <i data-lucide="sliders" style="width:14px;height:14px;"></i> Save <%= env.toUpperCase() %> Policy
          </button>
        </div>
      <% }); %>
    </div>

    <!-- SECTION 3: LIVE CLOUDWATCH & APPLICATION AUTO-SCALING ACTIVITY STREAM -->
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;padding:24px;box-shadow:0 4px 20px rgba(0,0,0,0.04);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
        <div>
          <h2 style="font-size:16px;font-weight:700;color:var(--color-text-primary);display:flex;align-items:center;gap:8px;margin:0;">
            <i data-lucide="activity" style="width:18px;height:18px;color:#6366f1;"></i> Live AWS Scaling Activity &amp; Alarm Audit Log
          </h2>
          <p style="font-size:12px;color:var(--color-text-secondary);margin-top:2px;">
            Inspect recent scale-out and scale-in events triggered by AWS Application Auto Scaling.
          </p>
        </div>

        <div style="display:flex;gap:6px;">
          <% ['dev', 'uat', 'prod'].forEach(function(env) { %>
            <button onclick="setActiveActivityTab('<%= env %>')" id="activity-tab-<%= env %>" class="activity-tab-btn <%= env === 'dev' ? 'active' : '' %>">
              <%= env %> <span id="activity-count-<%= env %>">(0)</span>
            </button>
          <% }); %>
        </div>
      </div>

      <!-- Activity List Container -->
      <div id="scaling-activity-container" style="display:flex;flex-direction:column;gap:10px;"></div>
    </div>
  <% } %>
</div>
