<% if (user.userType === 'developer' || user.userType === 'sales') { %>
<div class="bento-dashboard">
  <!-- Developer Bento Hero Tile -->
  <div class="bento-hero">
    <div class="bento-hero-info">
      <div class="bento-role-badge">
        <i data-lucide="terminal"></i>
        <span>Developer Workspace</span>
      </div>
      <h1 class="bento-hero-title">
        <span>Welcome back, <%= user.username %></span>
        <span class="bento-system-beacon">
          <span class="live-beacon online"></span>
          <span>Online</span>
        </span>
      </h1>
    </div>
    <div class="bento-hero-actions">
      <a href="/file-browser" class="bento-btn bento-btn-primary">
        <i data-lucide="folder-code" style="width:16px;height:16px;"></i> Browse Code Files
      </a>
      <a href="/branches" class="bento-btn bento-btn-secondary">
        <i data-lucide="git-branch" style="width:16px;height:16px;"></i> View Branches
      </a>
    </div>
  </div>

  <!-- Developer 4-Metric Bento Grid -->
  <div class="bento-grid-4">
    <!-- Assigned Projects Card -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Assigned Projects</span>
        <div class="bento-icon-pod">
          <i data-lucide="boxes"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div>
          <div id="dev-projects-count" class="bento-metric-val">Loading…</div>
          <div class="bento-metric-sub">Active workspace scope</div>
        </div>
      </div>
    </div>

    <!-- Connected Repository Card -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Connected Repo</span>
        <div class="bento-icon-pod">
          <i data-lucide="git-fork"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div style="min-width:0;width:100%;">
          <div id="dev-repo-name" class="bento-metric-val">Loading…</div>
          <div class="bento-metric-sub">Synced with Git provider</div>
        </div>
      </div>
    </div>

    <!-- Pipeline Health Status Card -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Pipeline Status</span>
        <div class="bento-icon-pod">
          <i data-lucide="activity"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div id="dev-pipeline-dot" class="live-beacon online" style="margin-right:2px;"></div>
        <div>
          <div id="dev-pipeline-status" class="bento-metric-val">Idle / Ready</div>
          <div class="bento-metric-sub">Automated CI/CD runner</div>
        </div>
      </div>
    </div>

    <!-- Default Branch Card -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Default Branch</span>
        <div class="bento-icon-pod">
          <i data-lucide="git-branch"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div>
          <div id="dev-branch-name" class="bento-metric-val" style="font-family:ui-monospace,monospace;">main</div>
          <div class="bento-metric-sub">Tracking production HEAD</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Developer Main Operations Split: Pipeline Tracker + Recent Commits -->
  <div class="bento-grid-main">
    <!-- Left: Project Pipeline Stream -->
    <div class="bento-stream-card">
      <div class="bento-stream-header">
        <h2 class="bento-stream-title">
          <i data-lucide="cpu"></i> Project Build &amp; Deployment Pipeline
        </h2>
        <a href="/pipelines" class="bento-stream-link">
          <span>View Pipelines</span>
          <i data-lucide="arrow-right" style="width:14px;height:14px;"></i>
        </a>
      </div>
      <div id="dev-pipeline-content" class="bento-stream-body">
        <div style="text-align:center;padding:48px 16px;color:var(--color-text-tertiary);font-size:13px;">Loading pipeline status…</div>
      </div>
    </div>

    <!-- Right: Recent Commits Stream -->
    <div class="bento-stream-card">
      <div class="bento-stream-header">
        <h2 class="bento-stream-title">
          <i data-lucide="git-commit"></i> Recent Project Commits
        </h2>
        <a href="/file-browser" class="bento-stream-link">
          <span>File Browser</span>
          <i data-lucide="arrow-right" style="width:14px;height:14px;"></i>
        </a>
      </div>
      <div id="dev-commits-list" class="bento-stream-body" style="gap:8px;">
        <div style="text-align:center;padding:48px 16px;color:var(--color-text-tertiary);font-size:13px;">Loading recent commits…</div>
      </div>
    </div>
  </div>
</div>

<% } else { %>

<div class="bento-dashboard">
  <!-- Admin / DevOps Bento Hero Tile -->
  <div class="bento-hero">
    <div class="bento-hero-info">
      <div class="bento-role-badge">
        <i data-lucide="shield-check"></i>
        <span>Enterprise Control Plane</span>
      </div>
      <h1 class="bento-hero-title">
        <span>Welcome back, <span id="dash-username"><%= user.username %></span></span>
        <span class="bento-system-beacon">
          <span class="live-beacon online"></span>
          <span>System Healthy</span>
        </span>
      </h1>
    </div>
    <div class="bento-hero-actions">
      <a href="/new-project" class="bento-btn bento-btn-primary">
        <i data-lucide="plus" style="width:16px;height:16px;"></i> New Project
      </a>
      <a href="/pipelines" class="bento-btn bento-btn-secondary">
        <i data-lucide="play" style="width:16px;height:16px;"></i> Trigger Build
      </a>
    </div>
  </div>

  <!-- System Health 4-Card Bento Strip -->
  <div class="bento-grid-4">
    <!-- Database Cluster -->
    <div id="card-db" class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Database Cluster</span>
        <div class="bento-icon-pod">
          <i data-lucide="database"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div id="db-dot" class="live-beacon"></div>
        <div style="min-width:0;overflow:hidden;">
          <div id="db-status" class="bento-metric-val">Checking…</div>
          <div id="db-host" class="bento-metric-sub">Aurora MySQL Cluster</div>
        </div>
      </div>
    </div>

    <!-- AWS Cloud Telemetry -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">AWS Region</span>
        <div class="bento-icon-pod">
          <i data-lucide="server"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div id="aws-dot" class="live-beacon"></div>
        <div>
          <div id="aws-status" class="bento-metric-val">Checking…</div>
          <div class="bento-metric-sub">us-east-1 (N. Virginia)</div>
        </div>
      </div>
    </div>

    <!-- SLA Operational Uptime -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Operational Uptime</span>
        <div class="bento-icon-pod">
          <i data-lucide="clock"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div class="live-beacon online"></div>
        <div>
          <div id="uptime-value" class="bento-metric-val">0 min</div>
          <div class="bento-metric-sub">99.98% High Availability</div>
        </div>
      </div>
    </div>

    <!-- Total Projects -->
    <div class="bento-metric-card">
      <div class="bento-metric-header">
        <span class="bento-metric-label">Total Projects</span>
        <div class="bento-icon-pod">
          <i data-lucide="cpu"></i>
        </div>
      </div>
      <div class="bento-metric-body">
        <div class="live-beacon online"></div>
        <div>
          <div id="projects-count" class="bento-metric-val">0 Active</div>
          <div class="bento-metric-sub">Active release pipelines</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ECS Environment Live Status (Conditionally revealed by client JS) -->
  <div id="deploy-endpoint" class="bento-env-section" style="display:none;">
    <div class="bento-section-heading">
      <i data-lucide="layers" style="width:14px;height:14px;color:var(--color-primary);"></i>
      <span>ECS Deployment Environments</span>
    </div>
    <div id="deploy-endpoint-text" style="display:flex;flex-wrap:wrap;gap:12px;align-items:stretch;"></div>
  </div>

  <!-- Operations Split Bento: Active Pipeline + Audit Stream -->
  <div class="bento-grid-main">
    <!-- Active Pipeline Execution Stream -->
    <div class="bento-stream-card">
      <div class="bento-stream-header">
        <h2 class="bento-stream-title">
          <i data-lucide="activity"></i> Active Pipeline Execution
        </h2>
        <a href="/pipelines" class="bento-stream-link">
          <span>View Pipelines</span>
          <i data-lucide="arrow-right" style="width:14px;height:14px;"></i>
        </a>
      </div>
      <div id="pipeline-content" class="bento-stream-body">
        <div style="text-align:center;padding:48px 16px;color:var(--color-text-tertiary);font-size:13px;">Loading pipeline status…</div>
      </div>
    </div>

    <!-- Recent Audit Logs Stream -->
    <div class="bento-stream-card">
      <div class="bento-stream-header">
        <h2 class="bento-stream-title">
          <i data-lucide="shield"></i> Security &amp; Audit Trail
        </h2>
        <a href="/audit-logs" class="bento-stream-link">
          <span>All Audit Logs</span>
          <i data-lucide="arrow-right" style="width:14px;height:14px;"></i>
        </a>
      </div>
      <div id="recent-activity" class="bento-stream-body">
        <div style="text-align:center;padding:48px 16px;color:var(--color-text-tertiary);font-size:13px;">Loading recent activity…</div>
      </div>
    </div>
  </div>
</div>
<% } %>
