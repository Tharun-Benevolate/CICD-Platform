<% if (user.userType === 'developer' || user.userType === 'sales') { %>
<div class="dash-container">
  <!-- Developer Workspace Banner -->
  <div class="dash-hero-card">
    <div class="dash-hero-content">
      <h1 class="dash-hero-title">
        Welcome back, <%= user.username %>
      </h1>
      <p class="dash-hero-subtitle">
        Overview of your assigned projects, repositories, and build pipelines.
      </p>
    </div>
    <div class="dash-hero-actions">
      <a href="/file-browser" class="dash-btn-primary">
        <i data-lucide="folder-code" style="width:15px;height:15px;"></i> Browse Code Files
      </a>
      <a href="/branches" class="dash-btn-secondary">
        <i data-lucide="git-branch" style="width:15px;height:15px;"></i> View Branches
      </a>
    </div>
  </div>

  <!-- Metric Cards Grid (Developer) -->
  <div class="dash-metrics-grid">
    <!-- Assigned Projects Card -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">ASSIGNED PROJECTS</span>
        <i data-lucide="boxes" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <span id="dev-projects-count" class="dash-metric-val">Loading…</span>
      </div>
    </div>

    <!-- Connected Repo Card -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">CONNECTED REPO</span>
        <i data-lucide="git-fork" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <span id="dev-repo-name" class="dash-metric-val">Loading…</span>
      </div>
    </div>

    <!-- Pipeline Status Card -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">PIPELINE STATUS</span>
        <i data-lucide="activity" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <div id="dev-pipeline-dot" class="dash-status-dot"></div>
        <span id="dev-pipeline-status" class="dash-metric-val">Idle / Ready</span>
      </div>
    </div>

    <!-- Default Branch Card -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">DEFAULT BRANCH</span>
        <i data-lucide="git-branch" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <span id="dev-branch-name" class="dash-metric-val font-mono">main</span>
      </div>
    </div>
  </div>

  <!-- Main Content Grid: Pipeline Tracker + Recent Commits -->
  <div class="dash-main-grid">
    <!-- Left: Active Pipeline -->
    <div class="dash-panel-card">
      <div class="dash-panel-header">
        <h2 class="dash-panel-title">
          <i data-lucide="activity"></i> Active Pipeline
        </h2>
        <a href="/pipelines" class="dash-panel-link">
          View Pipeline <i data-lucide="arrow-right" style="width:13px;height:13px;"></i>
        </a>
      </div>
      <div id="dev-pipeline-content" class="dash-panel-body">
        <div class="dash-empty-state">Loading pipeline status…</div>
      </div>
    </div>

    <!-- Right: Recent Commits -->
    <div class="dash-panel-card">
      <div class="dash-panel-header">
        <h2 class="dash-panel-title">
          <i data-lucide="git-commit"></i> Recent Activity
        </h2>
        <a href="/file-browser" class="dash-panel-link">
          File Browser <i data-lucide="arrow-right" style="width:13px;height:13px;"></i>
        </a>
      </div>
      <div id="dev-commits-list" class="dash-panel-body" style="gap:8px;">
        <div class="dash-empty-state">Loading recent commits…</div>
      </div>
    </div>
  </div>
</div>

<% } else { %>

<div class="dash-container">
  <!-- Admin / DevOps Clean Header Card -->
  <div class="dash-hero-card">
    <div class="dash-hero-content">
      <h1 class="dash-hero-title">
        Welcome back, <span id="dash-username"><%= user.username %></span>
      </h1>
      <p class="dash-hero-subtitle">
        Overview of your active infrastructure, deployments, and source repositories.
      </p>
    </div>
    <div class="dash-hero-actions">
      <a href="/new-project" class="dash-btn-primary">
        <i data-lucide="plus" style="width:16px;height:16px;"></i> New Project
      </a>
    </div>
  </div>

  <!-- System Health 4-Card Grid: DATABASE | AWS REGION | UPTIME | TOTAL PROJECTS -->
  <div class="dash-metrics-grid">
    <!-- Database Status -->
    <div id="card-db" class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">DATABASE</span>
        <i data-lucide="database" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <div id="db-dot" class="dash-status-dot"></div>
        <div class="dash-metric-text-group">
          <span id="db-status" class="dash-metric-val">Checking...</span>
          <span id="db-host" class="dash-metric-sub"></span>
        </div>
      </div>
    </div>

    <!-- AWS Region -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">AWS REGION</span>
        <i data-lucide="server" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <div id="aws-dot" class="dash-status-dot"></div>
        <span id="aws-status" class="dash-metric-val">Checking...</span>
      </div>
    </div>

    <!-- Uptime -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">UPTIME</span>
        <i data-lucide="clock" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <span id="uptime-value" class="dash-metric-val">0 min</span>
      </div>
    </div>

    <!-- Total Projects -->
    <div class="dash-metric-card">
      <div class="dash-metric-header">
        <span class="dash-metric-label">TOTAL PROJECTS</span>
        <i data-lucide="cpu" class="dash-metric-icon"></i>
      </div>
      <div class="dash-metric-value-row">
        <span id="projects-count" class="dash-metric-val">0 Active</span>
      </div>
    </div>
  </div>

  <!-- ECS Environment Status Section -->
  <div id="deploy-endpoint" class="dash-ecs-panel" style="display:none;">
    <div class="dash-ecs-header">
      <span class="dash-ecs-label">ECS ENVIRONMENT STATUS</span>
    </div>
    <div id="deploy-endpoint-text" class="dash-ecs-cards-row"></div>
  </div>

  <!-- Main Content Grid: Pipeline + Activity -->
  <div class="dash-main-grid">
    <!-- Active Pipeline -->
    <div class="dash-panel-card">
      <div class="dash-panel-header">
        <h2 class="dash-panel-title">
          <i data-lucide="activity"></i> Active Pipeline
        </h2>
        <a href="/pipelines" class="dash-panel-link">
          View Pipeline <i data-lucide="arrow-right" style="width:13px;height:13px;"></i>
        </a>
      </div>
      <div id="pipeline-content" class="dash-panel-body">
        <div class="dash-empty-state">Loading pipeline status...</div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="dash-panel-card">
      <div class="dash-panel-header">
        <h2 class="dash-panel-title">
          <i data-lucide="shield"></i> Recent Activity
        </h2>
        <a href="/audit-logs" class="dash-panel-link">
          All Logs <i data-lucide="arrow-right" style="width:13px;height:13px;"></i>
        </a>
      </div>
      <div id="recent-activity" class="dash-panel-body">
        <div class="dash-empty-state">Loading recent activity...</div>
      </div>
    </div>
  </div>
</div>
<% } %>
